<%- include("../partials/header") %>
<%
  function splitDesc(d) {
    d = d || "";
    var ing = "", eff = "";
    var mi = d.match(/Ingredients:\s*([\s\S]*?)(?:\n+\s*Effectiveness:|$)/i);
    var me = d.match(/Effectiveness:\s*([\s\S]*)$/i);
    if (mi) ing = (mi[1] || "").trim();
    if (me) eff = (me[1] || "").trim();
    if (!mi && !me && d.trim()) ing = d.trim();
    return { ing: ing, eff: eff };
  }
%>

<div class="page-intro">
  <h2>📦 All Categories</h2>
</div>

<div class="card">
  <form action="/admin/categories" method="get" class="orders-toolbar">
    <label class="ot-field">From <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field">To <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 Search</button>
    <% if (from || to) { %><a class="btn sm gray" href="/admin/categories">Clear</a><% } %>
    <a class="btn sm gray" href="/admin/batches">← Back</a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <strong><%= batches.length %></strong> categor<%= batches.length === 1 ? "y" : "ies" %><%
      if (from || to) { %> · added <%= from || "…" %> → <%= to || "…" %><% } %>
  </p>

  <% if (!batches.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🗂️</div>
      <div class="empty-title">No categories found</div>
      <div class="empty-sub">Try a different date range.</div>
    </div>
  <% } else { %>
    <div class="cat-grid">
      <% batches.forEach(b => { const fid = "cf" + b.id; const dd = splitDesc(b.description); %>
        <div class="cat-card <%= b.expired ? 'expired' : '' %>">
          <div class="cat-top">
            <div class="cat-thumb">
              <% if (b.image_path) { %>
                <img src="<%= apiBase %>/uploads/<%= b.image_path %>" alt="jaggery">
              <% } else { %>
                <span class="cat-noimg">No image</span>
              <% } %>
            </div>
            <div class="cat-meta">
              <strong class="cat-name"><%= b.batch_id %></strong>
              <span class="muted"><%= b.warehouse_name %></span>
              <span class="status status-<%= b.expiry_status === 'expired' ? 'cancelled' : (b.expiry_status === 'near_expiry' ? 'pending' : 'delivered') %>"><%= b.expiry_status %></span>
            </div>
          </div>

          <form id="<%= fid %>" action="/admin/batches/<%= b.id %>/update" method="post" class="cat-fields">
            <label>Grade
              <select name="grade">
                <% ["A","B","C"].forEach(g => { %><option <%= b.grade === g ? "selected" : "" %>><%= g %></option><% }) %>
              </select>
            </label>
            <label>Qty (kg)<input name="qty_kg" type="number" step="0.5" value="<%= b.qty_kg %>"></label>
            <label>Kyats/kg<input name="price_per_kg" type="number" step="0.5" value="<%= b.price_per_kg %>"></label>
            <label class="cat-active"><input type="checkbox" name="is_active" <%= b.is_active ? "checked" : "" %>> Active</label>
            <div class="desc-edit">
              <div class="de-col">
                <span class="de-head">🧪 Ingredients</span>
                <input type="text" name="ingredients" class="de-input" value="<%= dd.ing %>" placeholder="e.g. pure sugarcane juice">
              </div>
              <div class="de-col">
                <span class="de-head">💪 Effectiveness</span>
                <input type="text" name="effectiveness" class="de-input" value="<%= dd.eff %>" placeholder="e.g. rich in iron, aids digestion">
              </div>
              <button type="button" class="de-more" data-form="<%= fid %>" data-name="<%= b.batch_id %>">See more &amp; edit ⤢</button>
            </div>
          </form>

          <p class="muted cat-date" style="white-space:nowrap">📅 Added: <%= b.created_at ? b.created_at.substring(0,10) : "—" %> · Production: <%= b.harvest_date ? b.harvest_date.substring(0,10) : "—" %></p>

          <div class="cat-toolbar">
            <form action="/admin/batches/<%= b.id %>/image" method="post" enctype="multipart/form-data" class="ct-form">
              <label class="btn sm btn-outline upl-label" title="Upload image">⬆ Upload
                <input type="file" name="file" accept="image/*" class="js-img-input" onchange="if(!window.__inplaceImage)this.closest('form').submit()">
              </label>
            </form>
            <form action="/admin/batches/<%= b.id %>/image/remove" method="post" class="ct-form">
              <button class="btn sm btn-outline" type="submit" <%= b.image_path ? "" : "disabled" %>>Remove image</button>
            </form>
            <span class="spacer"></span>
            <button class="btn sm" type="submit" form="<%= fid %>">Save</button>
            <form action="/admin/batches/<%= b.id %>/delete" method="post" class="ct-form"
                  data-confirm="Delete category <%= b.batch_id %>?">
              <button class="btn sm danger" type="submit">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/desc_edit_modal") %>
<%- include("../partials/footer") %>
