<%- include("../partials/header") %>
<h2><%= t("All Orders") %></h2>
<a class="btn sm" href="/admin" style="display:inline-block;margin:.2rem 0 1rem">&larr; <%= t("Back to home") %></a>

<% if (error) { %><div class="alert err"><%= t(error) %></div><% } %>

<div class="card">
  <form action="/admin/orders" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (from || to) { %><a class="btn sm" href="/admin/orders"><%= t("Clear") %></a><% } %>
  </form>

  <div class="orders-toolbar" style="margin-top:.4rem;align-items:center">
    <label class="ot-field">🏬 <%= t("Warehouse") %> <select id="ordWh" style="padding:.25rem .4rem"></select></label>
    <a class="btn sm ot-pdf" id="ordPdf" href="/admin/orders/pdf" target="_blank">⬇ <%= t("Download PDF") %></a>
  </div>

  <p class="muted" id="ordCount" style="margin:.6rem 0">
    <strong><%= t("{n} order(s)", { n: orders.length }) %></strong><% if (from || to) { %> · <%= from || t('start') %> &rarr; <%= to || t('now') %><% } %>
  </p>

  <form id="ordDelForm" action="/admin/orders/delete" method="post" data-confirm="<%= t("Delete the selected order(s)? This permanently removes them and their items.") %>">
  <table class="tbl" id="ordTable">
    <thead><tr><th><input type="checkbox" class="ord-all" title="<%= t("Select all") %>"></th><th><%= t("No.") %></th><th><%= t("Date") %></th><th><%= t("Customer") %></th><th><%= t("Items") %></th><th><%= t("Total (Kyats)") %></th><th><%= t("Warehouse") %></th><th><%= t("Status") %></th></tr></thead>
    <tbody>
      <% if (!orders.length) { %>
        <tr class="no-data"><td colspan="8" class="muted" style="text-align:center;padding:1rem"><%= t("No orders found for this range.") %></td></tr>
      <% } %>
      <% orders.forEach((o) => {
           var whs = [...new Set(o.items.map(i => i.warehouse_name).filter(Boolean))];
           var whStr = whs.join(", ") || (o.warehouse_name || "—");
      %>
        <tr data-wh="<%= (whs.join('|') || o.warehouse_name || '') %>">
          <td class="dir-chk"><input type="checkbox" name="order_ids" value="<%= o.id %>" class="ord-cb"></td>
          <td class="ord-no"></td>
          <td><%= o.created_at ? o.created_at.substring(0,10) : "" %></td>
          <td><%= o.customer_name %></td>
          <td><%= o.items.map(i => i.batch_id + " ×" + i.qty_kg + "kg").join(", ") %></td>
          <td><%= o.grand_total %></td>
          <td><%= whStr %></td>
          <td><span class="status status-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="acc-actions"><button class="btn sm danger" type="submit">🗑 <%= t("Delete selected") %></button></div>
  </form>
  <p class="muted" id="ordNoRows" style="display:none;padding:.6rem"><%= t("No orders for this warehouse.") %></p>
</div>

<script>
  (function () {
    var L = <%- JSON.stringify({ allWh: t("All warehouses"), orders: t("{n} order(s)"), start: t("start"), now: t("now") }) %>;
    var whSel = document.getElementById("ordWh");
    var pdf = document.getElementById("ordPdf");
    var countEl = document.getElementById("ordCount");
    var noRows = document.getElementById("ordNoRows");
    var rows = Array.prototype.slice.call(document.querySelectorAll("#ordTable tbody tr[data-wh]"));
    var master = document.querySelector(".ord-all");
    function visibleCbs() {
      return rows.filter(function (tr) { return tr.style.display !== "none"; })
                 .map(function (tr) { return tr.querySelector(".ord-cb"); }).filter(Boolean);
    }
    var FROM = "<%= from %>", TO = "<%= to %>";
    // build the warehouse dropdown from the orders on this page (exact names)
    var whs = {};
    rows.forEach(function (tr) {
      (tr.getAttribute("data-wh") || "").split("|").forEach(function (w) { if (w) whs[w] = true; });
    });
    whSel.innerHTML = '<option value="">' + L.allWh + '</option>' +
      Object.keys(whs).sort().map(function (w) { return '<option value="' + w + '">' + w + '</option>'; }).join("");
    function syncPdf() {
      var q = [];
      if (FROM) q.push("from=" + encodeURIComponent(FROM));
      if (TO) q.push("to=" + encodeURIComponent(TO));
      if (whSel.value) q.push("warehouse=" + encodeURIComponent(whSel.value));
      pdf.href = "/admin/orders/pdf" + (q.length ? "?" + q.join("&") : "");
    }
    function render() {
      var wh = whSel.value, shown = 0;
      rows.forEach(function (tr) {
        var ok = !wh || (tr.getAttribute("data-wh") || "").split("|").indexOf(wh) !== -1;
        if (ok) { tr.style.display = ""; shown++; tr.querySelector(".ord-no").textContent = shown; }
        else { tr.style.display = "none"; var cb = tr.querySelector(".ord-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
      });
      if (master) master.checked = false;
      if (noRows) noRows.style.display = (rows.length && !shown) ? "" : "none";
      var parts = L.orders.replace("{n}", "<strong>" + shown + "</strong>");
      if (wh) parts += " · " + wh;
      if (FROM || TO) parts += " · " + (FROM || L.start) + " &rarr; " + (TO || L.now);
      countEl.innerHTML = parts;
      syncPdf();
    }
    whSel.addEventListener("change", render);
    if (master) {
      master.addEventListener("change", function () { visibleCbs().forEach(function (cb) { cb.checked = master.checked; }); });
      document.getElementById("ordTable").addEventListener("change", function (e) {
        if (e.target && e.target.classList.contains("ord-cb")) {
          var v = visibleCbs(); master.checked = v.length > 0 && v.every(function (cb) { return cb.checked; });
        }
      });
    }
    render();
  })();
</script>
<%- include("../partials/footer") %>
