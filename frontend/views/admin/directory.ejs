<%- include("../partials/header") %>
<div class="page-intro"><h2>👥 <%= t("Users & Warehouses") %></h2></div>

<div class="acc-summary">
  <div class="acc-stat">
    <span class="acc-stat-ico">👤</span>
    <span class="acc-stat-num"><%= counts.users_total || 0 %></span>
    <span class="acc-stat-lbl"><%= t("Users") %></span>
    <span class="acc-stat-sub"><span class="dot on"></span><%= t("{n} active", { n: counts.users_active || 0 }) %></span>
  </div>
  <div class="acc-stat">
    <span class="acc-stat-ico">🏬</span>
    <span class="acc-stat-num"><%= counts.warehouses_total || 0 %></span>
    <span class="acc-stat-lbl"><%= t("Warehouses") %></span>
    <span class="acc-stat-sub"><span class="dot on"></span><%= t("{n} active", { n: counts.warehouses_active || 0 }) %></span>
  </div>
</div>

<!-- Warehouses (first 5) -->
<div class="card">
  <div class="acc-head"><h3>🏬 <%= t("Warehouses") %> (<%= warehouses.length %>)</h3></div>
  <% if (!warehouses.length) { %>
    <p class="muted"><%= t("No warehouses yet.") %></p>
  <% } else { %>
  <form action="/admin/directory/warehouses/delete" method="post" data-confirm="<%= t("Delete the selected warehouse(s)? Their products & subscriptions will be removed too.") %>">
    <table class="tbl">
      <thead><tr><th><input type="checkbox" class="dir-all" title="<%= t("Select all") %>"></th><th><%= t("Warehouse") %></th><th><%= t("Email") %></th><th><%= t("Location") %></th><th><%= t("Staff") %></th><th><%= t("Subscription") %></th><th><%= t("Joined") %></th><th><%= t("Status") %></th></tr></thead>
      <tbody><%- include("../partials/dir_wh_rows", { rows: warehouses.slice(0, 5) }) %></tbody>
    </table>
    <div class="acc-actions">
      <button class="btn sm danger" type="submit">🗑 <%= t("Delete selected") %></button>
      <% if (warehouses.length > 5) { %>
        <a class="btn sm" href="/admin/directory/warehouses">📋 <%= t("Read more — view all {n} warehouses", { n: warehouses.length }) %> →</a>
      <% } %>
    </div>
  </form>
  <% } %>
</div>

<!-- Users (first 5) -->
<div class="card">
  <div class="acc-head"><h3>👤 <%= t("Users") %> (<%= users.length %>)</h3></div>
  <form action="/admin/directory/users/delete" method="post" data-confirm="<%= t("Delete the selected user(s)? This also removes their orders & related data.") %>">
    <table class="tbl">
      <thead><tr><th><input type="checkbox" class="dir-all" title="<%= t("Select all") %>"></th><th><%= t("Name") %></th><th><%= t("Email") %></th><th><%= t("Role") %></th><th><%= t("Joined") %></th><th><%= t("Last active") %></th><th><%= t("Status") %></th></tr></thead>
      <tbody><%- include("../partials/dir_user_rows", { rows: users.slice(0, 5) }) %></tbody>
    </table>
    <div class="acc-actions">
      <button class="btn sm danger" type="submit">🗑 <%= t("Delete selected") %></button>
      <% if (users.length > 5) { %>
        <a class="btn sm" href="/admin/directory/users">📋 <%= t("Read more — view all {n} users", { n: users.length }) %> →</a>
      <% } %>
    </div>
  </form>
</div>

<%- include("../partials/dir_filter_script") %>
<%- include("../partials/footer") %>
