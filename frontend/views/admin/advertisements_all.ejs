<%- include("../partials/header") %>

<div class="page-intro">
  <h2>📣 <%= t("All Advertisements") %></h2>
</div>

<div class="card">
  <form action="/admin/advertisements-all" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("Name") %> <input type="text" name="q" value="<%= q %>" placeholder="<%= t("Search title…") %>"></label>
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (q || from || to) { %><a class="btn sm gray" href="/admin/advertisements-all"><%= t("Clear") %></a><% } %>
    <a class="btn sm gray" href="/admin/advertisements">← <%= t("Back") %></a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <strong><%= t(ads.length === 1 ? "{n} advertisement" : "{n} advertisements", { n: ads.length }) %></strong><%
      if (q) { %> · <%= t("name “{q}”", { q: q }) %><% }
      if (from || to) { %> · <%= t("running {from} → {to}", { from: from || "…", to: to || "…" }) %><% } %>
  </p>

  <% if (!ads.length) { %>
    <div class="empty-state">
      <div class="empty-icon">📭</div>
      <div class="empty-title"><%= t("No advertisements found") %></div>
      <div class="empty-sub"><%= t("Try a different name or date range.") %></div>
    </div>
  <% } else { %>
    <div class="ad-admin-grid">
      <% ads.forEach(function (ad) { %>
        <%- include("../partials/ad_admin_card", { ad: ad }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>
