  <p class="muted" style="margin:.1rem 0 .6rem">Send one announcement or promotion email to every customer at once.</p>
  <form action="/admin/email/bulk" method="post" class="row-form">
    <input name="subject" placeholder="Subject" required style="flex:1">
    <input name="body" placeholder="Message body" required style="flex:2">
    <button class="btn sm" type="submit">Send</button>
  </form>
</div>

<div class="card">
  <h3>Audit logs (latest 30)</h3>
  <div class="orders-toolbar" style="justify-content:flex-start;margin-bottom:.6rem;flex-wrap:wrap">
    <label class="ot-field">📅 From <input type="date" id="auditFrom"></label>
    <label class="ot-field">📅 To <input type="date" id="auditTo"></label>
    <label class="ot-field">👤 Name <input type="text" id="auditName" placeholder="user name…" style="min-width:150px"></label>
    <label class="ot-field">📧 Email <input type="text" id="auditEmail" placeholder="user email…" style="min-width:170px"></label>
    <button type="button" class="btn sm" id="auditSearch">🔍 Search</button>
    <button type="button" class="btn sm gray" id="auditClear">Clear</button>
  </div>
  <p class="muted" id="auditCount" style="margin:.4rem 0"></p>
  <form action="/admin/audit-logs/delete" method="post" data-confirm="Delete the selected audit log(s)? This cannot be undone.">
    <table class="tbl" id="auditTable">
      <thead><tr><th><input type="checkbox" class="audit-all" title="Select all"></th><th>When</th><th>User</th><th>Email</th><th>Action</th><th>Details</th><th>IP</th></tr></thead>
      <tbody>
        <% audit.forEach(a => { var ad = a.created_at ? a.created_at.substring(0,10) : ""; %>
          <tr data-date="<%= ad %>" data-name="<%= (a.user_name || '').toLowerCase() %>" data-email="<%= (a.user_email || '').toLowerCase() %>">
              <td><input type="checkbox" name="audit_ids" value="<%= a.id %>" class="audit-cb"></td>
              <td class="muted"><%= a.created_at ? a.created_at.substring(0,19).replace("T"," ") : "" %></td>
              <td><%= a.user_name || "—" %></td>
              <td class="muted"><%= a.user_email || "—" %></td>
              <td><%= a.action %></td>
              <td><%= a.details || "" %></td><td class="muted"><%= a.ip_address || "" %></td></tr>
        <% }) %>
      </tbody>
    </table>
    <p class="muted" id="auditNoRows" style="display:none;padding:.6rem">No audit logs match this filter.</p>
    <div style="display:flex;gap:.5rem;align-items:center;margin-top:.6rem;flex-wrap:wrap">
      <button class="btn sm danger" type="submit">🗑 Delete selected</button>
      <button type="button" class="btn sm" id="auditMoreBtn" style="display:none"></button>
    </div>
  </form>

  <script>
    // Audit logs: filter by date range + email, then show at most 5 (with "See more").
    (function () {
      var rows = Array.prototype.slice.call(document.querySelectorAll("#auditTable tbody tr"));
      if (!rows.length) return;
      var fromEl = document.getElementById("auditFrom"), toEl = document.getElementById("auditTo");
      var nameEl = document.getElementById("auditName");
      var emailEl = document.getElementById("auditEmail");
      var moreBtn = document.getElementById("auditMoreBtn");
      var noRows = document.getElementById("auditNoRows");
      var countEl = document.getElementById("auditCount");
      var CAP = 5, expanded = false;
      function matches(tr) {
        var d = tr.getAttribute("data-date") || "", em = tr.getAttribute("data-email") || "", nm = tr.getAttribute("data-name") || "";
        var f = fromEl.value, t = toEl.value;
        var q = (emailEl.value || "").trim().toLowerCase();
        var qn = (nameEl.value || "").trim().toLowerCase();
        if (f && d && d < f) return false;
        if (t && d && d > t) return false;
        if (q && em.indexOf(q) === -1) return false;
        if (qn && nm.indexOf(qn) === -1) return false;
        return true;
      }
      function render() {
        var matched = 0, shown = 0;
        rows.forEach(function (tr) {
          if (matches(tr)) {
            matched++;
            if (expanded || shown < CAP) { tr.style.display = ""; shown++; } else { tr.style.display = "none"; }
          } else { tr.style.display = "none"; }
        });
        noRows.style.display = matched ? "none" : "";
        if (matched > CAP) {
          moreBtn.style.display = "";
          moreBtn.textContent = expanded ? "▲ Show less" : ("▾ See " + (matched - CAP) + " more");
        } else { moreBtn.style.display = "none"; }
        countEl.innerHTML = "<strong>" + matched + "</strong> log" + (matched === 1 ? "" : "s") +
          (matched > CAP && !expanded ? (" · showing " + Math.min(CAP, matched)) : "");
      }
      moreBtn.addEventListener("click", function () { expanded = !expanded; render(); });
      document.getElementById("auditSearch").addEventListener("click", function () { expanded = false; render(); });
      document.getElementById("auditClear").addEventListener("click", function () {
        fromEl.value = ""; toEl.value = ""; nameEl.value = ""; emailEl.value = ""; expanded = false; render();
      });
      [fromEl, toEl, nameEl, emailEl].forEach(function (el) { el.addEventListener("change", function () { expanded = false; render(); }); });
      [nameEl, emailEl].forEach(function (el) { el.addEventListener("keyup", function () { expanded = false; render(); }); });
      render();
    })();

    // "Select all" for audit logs — only toggles the rows currently shown by the filter
    (function () {
      var master = document.querySelector(".audit-all");
      if (!master) return;
      var table = master.closest("table");
      function boxes() { return Array.prototype.slice.call(table.querySelectorAll(".audit-cb")); }
      function visible() { return boxes().filter(function (cb) { return cb.closest("tr").style.display !== "none"; }); }
      master.addEventListener("change", function () {
        visible().forEach(function (cb) { cb.checked = master.checked; });
      });
      table.addEventListener("change", function (e) {
        if (e.target && e.target.classList.contains("audit-cb")) {
          var v = visible();
          master.checked = v.length > 0 && v.every(function (cb) { return cb.checked; });
        }
      });
    })();
  </script>
</div>

<!-- Shared "Block with a time limit" dialog (used by every Block button) -->
<div class="modal-overlay" id="blockModal" style="display:none">
  <div class="modal-box" style="max-width:430px">
    <div class="block-modal-head"><span class="block-modal-ico">🚫</span><h3 style="margin:.2rem 0">Block <span id="blockTargetName"></span></h3></div>
    <p class="muted" style="margin:.2rem 0 .9rem">Set how long the block lasts. Nothing is deleted — access returns automatically when the time is up (or as soon as you unblock).</p>
    <form id="blockForm" method="post" action="">
      <label style="display:block;margin-bottom:.5rem">Block duration
        <select id="blockDurSel" class="acc-search" style="width:100%;border-radius:8px;margin-top:.25rem">
          <option value="60">1 hour</option>
          <option value="360">6 hours</option>
          <option value="1440" selected>1 day</option>
          <option value="4320">3 days</option>
          <option value="10080">1 week</option>
          <option value="43200">30 days</option>
          <option value="0">No time limit (until I unblock)</option>
          <option value="custom">Custom date &amp; time…</option>
        </select>
      </label>
      <label id="blockCustomWrap" style="display:none;margin-bottom:.5rem">Block until
        <input type="datetime-local" id="blockUntilInput" class="acc-search" style="width:100%;border-radius:8px;margin-top:.25rem">
      </label>
      <p class="muted" id="blockSummary" style="font-size:.82rem;margin:.2rem 0 .9rem"></p>
      <input type="hidden" name="minutes" id="blockMinutesField">
      <input type="hidden" name="until" id="blockUntilField">
      <div class="inline" style="gap:.5rem;justify-content:flex-end">
        <button type="button" class="btn sm gray" id="blockCancel">Cancel</button>
        <button type="submit" class="btn sm block-btn">🚫 Block</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function () {
    var modal = document.getElementById("blockModal");
    if (!modal) return;
    var form = document.getElementById("blockForm");
    var nameEl = document.getElementById("blockTargetName");
    var sel = document.getElementById("blockDurSel");
    var customWrap = document.getElementById("blockCustomWrap");
    var untilInput = document.getElementById("blockUntilInput");
    var minutesField = document.getElementById("blockMinutesField");
    var untilField = document.getElementById("blockUntilField");
    var summary = document.getElementById("blockSummary");

    function fmt(dt) { return dt.toLocaleString(undefined, { weekday: "short", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }); }
    function targetDate() {
      if (sel.value === "custom") return untilInput.value ? new Date(untilInput.value) : null;
      var m = parseInt(sel.value, 10) || 0;
      if (m <= 0) return null; // no limit
      return new Date(Date.now() + m * 60000);
    }
    function refresh() {
      customWrap.style.display = sel.value === "custom" ? "" : "none";
      if (sel.value === "0") { summary.textContent = "⛔ Blocked until you unblock them (no time limit)."; return; }
      var d = targetDate();
      summary.textContent = d ? ("⏳ Will automatically unblock on " + fmt(d) + ".") : "Pick a date & time above.";
    }
    sel.addEventListener("change", refresh);
    untilInput.addEventListener("input", refresh);

    function openModal(action, name) {
      form.setAttribute("action", action);
      nameEl.textContent = name || "this account";
      sel.value = "1440"; customWrap.style.display = "none"; untilInput.value = "";
      refresh();
      modal.style.display = "flex";
    }
    function close() { modal.style.display = "none"; }
    document.getElementById("blockCancel").addEventListener("click", close);
    modal.addEventListener("click", function (e) { if (e.target === modal) close(); });

    // every Block button opens this dialog instead of submitting directly
    document.addEventListener("click", function (e) {
      var btn = e.target.closest(".block-open");
      if (!btn) return;
      e.preventDefault();
      openModal(btn.dataset.action, btn.dataset.name);
    });

    form.addEventListener("submit", function (e) {
      if (sel.value === "custom") {
        if (!untilInput.value) { e.preventDefault(); alert("Please pick a date & time, or choose a preset."); return; }
        untilField.value = new Date(untilInput.value).toISOString();
        minutesField.value = "";
      } else {
        untilField.value = "";
        minutesField.value = sel.value; // "0" = no limit
      }
    });
  })();
</script>
