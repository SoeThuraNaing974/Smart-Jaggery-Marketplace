      function close() { modal.style.display = "none"; }
      if (openBtn) openBtn.addEventListener("click", open);
      document.getElementById("annClose").addEventListener("click", close);
      modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
      var input = document.getElementById("annSearchInput");
      var from = document.getElementById("annFrom"), to = document.getElementById("annTo");
      var rows = Array.prototype.slice.call(document.querySelectorAll("#annTable tbody tr"));
      var noRows = document.getElementById("annNoRows");
      function applyFilter() {
        var q = (input.value || "").trim().toLowerCase(), f = from.value, t = to.value, shown = 0;
        rows.forEach(function (tr) {
          var txt = tr.getAttribute("data-text") || "", d = tr.getAttribute("data-date") || "";
          var ok = (!q || txt.indexOf(q) !== -1) && (!f || (d && d >= f)) && (!t || (d && d <= t));
          tr.style.display = ok ? "" : "none";
          if (ok) shown++; else { var cb = tr.querySelector(".bulk-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
        });
        var annMaster = document.querySelector('.bulk-all[data-group="annAll"]');
        if (annMaster) annMaster.checked = false;
        noRows.style.display = shown ? "none" : "";
      }
      input.addEventListener("input", applyFilter);
      from.addEventListener("change", applyFilter);
      to.addEventListener("change", applyFilter);
      document.getElementById("annClear").addEventListener("click", function () { input.value = ""; from.value = ""; to.value = ""; applyFilter(); });
    })();
