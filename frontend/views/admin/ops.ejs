<%- include("../partials/header") %>
<h2>Maintain</h2>
<% function fmtUntil(iso){ if(!iso) return ''; try { return new Date(iso).toLocaleString(undefined,{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}); } catch(e){ return ''; } } %>

  <div class="card">
    <h3>Warehouses List <span class="muted">(<%= warehouses.length %>)</span></h3>
    <% if (!warehouses.length) { %><p class="muted">No warehouses yet.</p><% } else { %>
    <form id="bulkWh" action="/admin/warehouses/bulk-delete" method="post" data-confirm="Delete the selected warehouse(s)? Their products & packages will be removed too."></form>
    <table class="tbl">
      <thead><tr><th><input type="checkbox" class="bulk-all" data-group="wh" title="Select all"></th><th>No.</th><th>Name</th><th>🗺️ Location</th><th>✉ Email</th><th>☎ Phone</th><th>📅 Started</th><th style="text-align:center">Action</th></tr></thead>
      <tbody>
        <% warehouses.slice(0,3).forEach((w, idx) => { %>
          <tr class="<%= [w.isNew && 'row-new', w.blocked && 'row-blocked'].filter(Boolean).join(' ') %>">
            <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="wh" name="wh_ids" value="<%= w.id %>" form="bulkWh"></td>
            <td><%= idx + 1 %></td>
            <td><strong><%= w.name %></strong><% if (w.isNew) { %> <span class="new-pill">🆕 NEW</span><% } %><% if (w.blocked) { %> <span class="blocked-pill" title="<%= w.blocked_until ? ('Blocked until ' + new Date(w.blocked_until).toLocaleString()) : 'No time limit (until unblocked)' %>">⛔ Blocked<% if (w.blocked_until) { %> · ⏳ <%= fmtUntil(w.blocked_until) %><% } %></span><% } %></td>
            <td><%= w.location %></td>
            <td class="muted"><%= w.email || "—" %></td>
            <td class="muted"><%= w.phone || "—" %></td>
            <td class="muted"><%= w.created_at ? w.created_at.substring(0,10) : "—" %></td>
            <td>
              <div class="inline" style="display:flex;flex-wrap:nowrap;justify-content:center;gap:.4rem">
                <a class="btn sm" href="/admin/warehouses/<%= w.id %>">🔍 Details</a>
                <% if (w.blocked) { %>
                <form action="/admin/warehouses/<%= w.id %>/unblock" method="post" class="inline"
                      data-confirm="Unblock <%= w.name %>? Its staff can use their account again."><button class="btn sm ok-btn" type="submit">✅ Unblock</button></form>
                <% } else { %>
                <button type="button" class="btn sm block-btn block-open" data-action="/admin/warehouses/<%= w.id %>/block" data-name="<%= w.name %>" data-kind="warehouse">🚫 Block</button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="acc-actions" style="margin-bottom:1rem"><button class="btn sm danger" type="submit" form="bulkWh">🗑 Delete selected</button></div>
    <% } %>
    <% if (warehouses.length > 3) { %>
      <button type="button" class="btn sm" id="whReadMore" style="margin-bottom:.7rem">🏬 Read more — view all <%= warehouses.length %> warehouses →</button>
    <% } %>
    <form action="/admin/warehouses" method="post" class="row-form">
      <input name="name" placeholder="Name" required>
      <input name="location" placeholder="Location" required>
      <input name="email" type="email" placeholder="Email">
      <input name="phone" placeholder="Phone">
      <button class="btn sm" type="submit">Add warehouse</button>
    </form>

    <!-- popup: all warehouses with added date + date search -->
    <div class="modal-overlay" id="whModal" style="display:none">
      <div class="modal-box perf-modal-box">
        <div class="perf-modal-head">🏬 All warehouses — <%= warehouses.length %></div>
        <div class="orders-toolbar" style="justify-content:flex-start;margin-bottom:.4rem">
          <label class="ot-field">From <input type="date" id="whFrom"></label>
          <label class="ot-field">To <input type="date" id="whTo"></label>
          <button type="button" class="btn sm" id="whSearch">🔍 Search</button>
          <button type="button" class="btn sm gray" id="whClear">Clear</button>
        </div>
        <div class="perf-modal-scroll">
          <form id="bulkWhAll" action="/admin/warehouses/bulk-delete" method="post" data-confirm="Delete the selected warehouse(s)? Their products & packages will be removed too."></form>
          <table class="tbl" id="whTable">
            <thead><tr><th><input type="checkbox" class="bulk-all" data-group="whAll" title="Select all"></th><th>No.</th><th>Name</th><th>Location</th><th>Email</th><th>📅 Started</th><th style="text-align:center">Action</th></tr></thead>
            <tbody>
              <% warehouses.forEach((w, idx) => { var d = w.created_at ? w.created_at.substring(0,10) : ""; %>
                <tr data-date="<%= d %>" class="<%= [w.isNew && 'row-new', w.blocked && 'row-blocked'].filter(Boolean).join(' ') %>">
                  <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="whAll" name="wh_ids" value="<%= w.id %>" form="bulkWhAll"></td>
                  <td><strong><%= idx + 1 %></strong></td>
                  <td><%= w.name %><% if (w.isNew) { %> <span class="new-pill">🆕 NEW</span><% } %><% if (w.blocked) { %> <span class="blocked-pill" title="<%= w.blocked_until ? ('Blocked until ' + new Date(w.blocked_until).toLocaleString()) : 'No time limit (until unblocked)' %>">⛔ Blocked<% if (w.blocked_until) { %> · ⏳ <%= fmtUntil(w.blocked_until) %><% } %></span><% } %></td>
                  <td><%= w.location %></td>
                  <td class="muted"><%= w.email || "—" %></td>
                  <td class="muted"><%= d || "—" %></td>
                  <td>
                    <div class="inline" style="display:flex;flex-wrap:nowrap;justify-content:center;gap:.4rem">
                      <a class="btn sm" href="/admin/warehouses/<%= w.id %>">🔍 Details</a>
                      <% if (w.blocked) { %>
                      <form action="/admin/warehouses/<%= w.id %>/unblock" method="post" class="inline"
                            data-confirm="Unblock <%= w.name %>? Its staff can use their account again."><button class="btn sm ok-btn" type="submit">✅ Unblock</button></form>
                      <% } else { %>
                      <button type="button" class="btn sm block-btn block-open" data-action="/admin/warehouses/<%= w.id %>/block" data-name="<%= w.name %>" data-kind="warehouse">🚫 Block</button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="muted" id="whNoRows" style="display:none;padding:.6rem">No warehouses in this date range.</p>
        </div>
        <div class="acc-actions" style="margin-top:.7rem">
          <button class="btn sm danger" type="submit" form="bulkWhAll">🗑 Delete selected</button>
          <button type="button" class="btn" id="whClose">Close</button>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var modal = document.getElementById("whModal");
        if (!modal) return;
        var openBtn = document.getElementById("whReadMore");
        function open() { modal.style.display = "flex"; }
        function close() { modal.style.display = "none"; }
        if (openBtn) openBtn.addEventListener("click", open);
        document.getElementById("whClose").addEventListener("click", close);
        modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
        var from = document.getElementById("whFrom"), to = document.getElementById("whTo");
        var rows = Array.prototype.slice.call(document.querySelectorAll("#whTable tbody tr"));
        var noRows = document.getElementById("whNoRows");
        function applyFilter() {
          var f = from.value, t = to.value, shown = 0;
          rows.forEach(function (tr) {
            var d = tr.getAttribute("data-date") || "";
            var ok = (!f || (d && d >= f)) && (!t || (d && d <= t));
            tr.style.display = ok ? "" : "none";
            if (ok) shown++; else { var cb = tr.querySelector(".bulk-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
          });
          var m = document.querySelector('.bulk-all[data-group="whAll"]');
          if (m) m.checked = false;
          noRows.style.display = shown ? "none" : "";
        }
        document.getElementById("whSearch").addEventListener("click", applyFilter);
        document.getElementById("whClear").addEventListener("click", function () { from.value = ""; to.value = ""; applyFilter(); });
      })();
    </script>
  </div>

  <% function uRole(r){ return r === 'warehouse' ? '🏬 Warehouse' : (r === 'admin' ? '🛡️ Admin' : '🛍️ Customer'); } %>
  <div class="card">
    <h3>Users List <span class="muted">(<%= users.length %>)</span></h3>
    <% if (!users.length) { %><p class="muted">No users yet.</p><% } else { %>
    <form id="bulkUsr" action="/admin/users/bulk-delete" method="post" data-confirm="Delete the selected user(s)? This also removes their orders & related data."></form>
    <table class="tbl">
      <thead><tr><th><input type="checkbox" class="bulk-all" data-group="usr" title="Select all"></th><th>No.</th><th>Name</th><th>✉ Email</th><th>👤 Role</th><th>📅 Joined</th><th style="text-align:center">Action</th></tr></thead>
      <tbody>
        <% users.slice(0,3).forEach((u, idx) => { %>
          <tr class="<%= [u.isNew && 'row-new', u.blocked && 'row-blocked'].filter(Boolean).join(' ') %>">
            <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="usr" name="user_ids" value="<%= u.id %>" form="bulkUsr"<% if (u.role === 'admin') { %> disabled title="Admin accounts can't be deleted"<% } %>></td>
            <td><%= idx + 1 %></td>
            <td><strong><%= u.name %></strong><% if (u.isNew) { %> <span class="new-pill">🆕 NEW</span><% } %><% if (u.blocked) { %> <span class="blocked-pill" title="<%= u.blocked_until ? ('Blocked until ' + new Date(u.blocked_until).toLocaleString()) : 'No time limit (until unblocked)' %>">⛔ Blocked<% if (u.blocked_until) { %> · ⏳ <%= fmtUntil(u.blocked_until) %><% } %></span><% } %></td>
            <td class="muted"><%= u.email || "—" %></td>
            <td class="muted"><%= uRole(u.role) %></td>
            <td class="muted"><%= u.created_at ? u.created_at.substring(0,10) : "—" %></td>
            <td>
              <div class="inline" style="display:flex;flex-wrap:nowrap;justify-content:center;gap:.4rem">
                <% if (u.role === 'admin') { %>
                  <span class="muted" style="font-size:.78rem">Protected</span>
                <% } else if (u.blocked) { %>
                  <form action="/admin/users/<%= u.id %>/unblock" method="post" class="inline"
                        data-confirm="Unblock <%= u.name %>? They can use their account again."><button class="btn sm ok-btn" type="submit">✅ Unblock</button></form>
                <% } else { %>
                  <button type="button" class="btn sm block-btn block-open" data-action="/admin/users/<%= u.id %>/block" data-name="<%= u.name %>" data-kind="user">🚫 Block</button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="acc-actions"><button class="btn sm danger" type="submit" form="bulkUsr">🗑 Delete selected</button></div>
    <% } %>
    <% if (users.length > 3) { %>
      <button type="button" class="btn sm" id="usrReadMore" style="margin-top:.7rem;margin-bottom:.7rem">👤 Read more — view all <%= users.length %> users →</button>
    <% } %>

    <!-- popup: all users with joined date + date search -->
    <div class="modal-overlay" id="usrModal" style="display:none">
      <div class="modal-box perf-modal-box">
        <div class="perf-modal-head">👤 All users — <%= users.length %></div>
        <div class="orders-toolbar" style="justify-content:flex-start;margin-bottom:.4rem">
          <label class="ot-field">From <input type="date" id="usrFrom"></label>
          <label class="ot-field">To <input type="date" id="usrTo"></label>
          <button type="button" class="btn sm" id="usrSearch">🔍 Search</button>
          <button type="button" class="btn sm gray" id="usrClear">Clear</button>
        </div>
        <div class="perf-modal-scroll">
          <form id="bulkUsrAll" action="/admin/users/bulk-delete" method="post" data-confirm="Delete the selected user(s)? This also removes their orders & related data."></form>
          <table class="tbl" id="usrTable">
            <thead><tr><th><input type="checkbox" class="bulk-all" data-group="usrAll" title="Select all"></th><th>No.</th><th>Name</th><th>Email</th><th>Role</th><th>📅 Joined</th><th style="text-align:center">Action</th></tr></thead>
            <tbody>
              <% users.forEach((u, idx) => { var d = u.created_at ? u.created_at.substring(0,10) : ""; %>
                <tr data-date="<%= d %>" class="<%= [u.isNew && 'row-new', u.blocked && 'row-blocked'].filter(Boolean).join(' ') %>">
                  <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="usrAll" name="user_ids" value="<%= u.id %>" form="bulkUsrAll"<% if (u.role === 'admin') { %> disabled title="Admin accounts can't be deleted"<% } %>></td>
                  <td><strong><%= idx + 1 %></strong></td>
                  <td><%= u.name %><% if (u.isNew) { %> <span class="new-pill">🆕 NEW</span><% } %><% if (u.blocked) { %> <span class="blocked-pill" title="<%= u.blocked_until ? ('Blocked until ' + new Date(u.blocked_until).toLocaleString()) : 'No time limit (until unblocked)' %>">⛔ Blocked<% if (u.blocked_until) { %> · ⏳ <%= fmtUntil(u.blocked_until) %><% } %></span><% } %></td>
                  <td class="muted"><%= u.email || "—" %></td>
                  <td class="muted"><%= uRole(u.role) %></td>
                  <td class="muted"><%= d || "—" %></td>
                  <td>
                    <div class="inline" style="display:flex;flex-wrap:nowrap;justify-content:center;gap:.4rem">
                      <% if (u.role === 'admin') { %>
                        <span class="muted" style="font-size:.78rem">Protected</span>
                      <% } else if (u.blocked) { %>
                        <form action="/admin/users/<%= u.id %>/unblock" method="post" class="inline"
                              data-confirm="Unblock <%= u.name %>? They can use their account again."><button class="btn sm ok-btn" type="submit">✅ Unblock</button></form>
                      <% } else { %>
                        <button type="button" class="btn sm block-btn block-open" data-action="/admin/users/<%= u.id %>/block" data-name="<%= u.name %>" data-kind="user">🚫 Block</button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="muted" id="usrNoRows" style="display:none;padding:.6rem">No users in this date range.</p>
        </div>
        <div class="acc-actions" style="margin-top:.7rem">
          <button class="btn sm danger" type="submit" form="bulkUsrAll">🗑 Delete selected</button>
          <button type="button" class="btn" id="usrClose">Close</button>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var modal = document.getElementById("usrModal");
        if (!modal) return;
        var openBtn = document.getElementById("usrReadMore");
        function open() { modal.style.display = "flex"; }
        function close() { modal.style.display = "none"; }
        if (openBtn) openBtn.addEventListener("click", open);
        document.getElementById("usrClose").addEventListener("click", close);
        modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
        var from = document.getElementById("usrFrom"), to = document.getElementById("usrTo");
        var rows = Array.prototype.slice.call(document.querySelectorAll("#usrTable tbody tr"));
        var noRows = document.getElementById("usrNoRows");
        function applyFilter() {
          var f = from.value, t = to.value, shown = 0;
          rows.forEach(function (tr) {
            var d = tr.getAttribute("data-date") || "";
            var ok = (!f || (d && d >= f)) && (!t || (d && d <= t));
            tr.style.display = ok ? "" : "none";
            if (ok) shown++; else { var cb = tr.querySelector(".bulk-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
          });
          var m = document.querySelector('.bulk-all[data-group="usrAll"]');
          if (m) m.checked = false;
          noRows.style.display = shown ? "none" : "";
        }
        document.getElementById("usrSearch").addEventListener("click", applyFilter);
        document.getElementById("usrClear").addEventListener("click", function () { from.value = ""; to.value = ""; applyFilter(); });
      })();
    </script>
  </div>

  <div class="card">
    <h3>Delivery charges (per Location) <span class="muted">(<%= charges.length %>)</span></h3>
    <% if (!charges.length) { %><p class="muted">No delivery charges yet — add one below.</p><% } else { %>
      <form id="bulkDc" action="/admin/delivery-charges/bulk-delete" method="post" data-confirm="Delete the selected delivery charge(s)?"></form>
      <table class="tbl">
        <thead><tr><th><input type="checkbox" class="bulk-all" data-group="dc" title="Select all"></th><th>No.</th><th>📍 Location</th><th>📅 Added</th><th style="text-align:center">Charge (Kyats)</th><th style="text-align:center">Action</th></tr></thead>
        <tbody>
          <% charges.slice(0,3).forEach((c, idx) => { %>
            <tr>
              <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="dc" name="dc_ids" value="<%= c.id %>" form="bulkDc"></td>
              <td><%= idx + 1 %></td>
              <td><strong><%= c.pincode %></strong></td>
              <td class="muted"><%= c.created_at ? c.created_at.substring(0,10) : "—" %></td>
              <td>
                <form action="/admin/delivery-charges" method="post" class="inline" style="gap:.3rem;display:flex;justify-content:center">
                  <input type="hidden" name="pincode" value="<%= c.pincode %>">
                  <input name="charge_amount" type="text" inputmode="numeric" value="<%= c.charge_amount %>" style="width:75px"
                    oninput="this.value=this.value.replace(/[^0-9]/g,'')"> Kyats
                  <button class="btn sm" type="submit">Save</button>
                </form>
              </td>
              <td style="text-align:center">
                <form action="/admin/delivery-charges/<%= c.id %>/delete" method="post" class="inline"
                      data-confirm="Delete delivery charge for <%= c.pincode %>?">
                  <button class="btn sm danger" type="submit">🗑 Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="acc-actions"><button class="btn sm danger" type="submit" form="bulkDc">🗑 Delete selected</button></div>
      <% if (charges.length > 3) { %>
        <button type="button" class="btn sm" id="dcReadMore" style="margin:.3rem 0 .7rem">🚚 Read more — view all <%= charges.length %> locations →</button>
      <% } %>
    <% } %>

    <form action="/admin/delivery-charges" method="post" class="row-form" id="dcAddForm">
      <input name="pincode" placeholder="City (optional)" list="mmCities" autocomplete="off">
      <input name="charge_amount" type="text" inputmode="numeric" placeholder="Amount (Kyats)" required
             oninput="this.value=this.value.replace(/[^0-9]/g,'')">
      <button class="btn sm" type="submit">Add</button>
    </form>
    <datalist id="mmCities">
      <% [
        "Yangon","Mandalay","Naypyitaw","Bago","Mawlamyine","Taunggyi","Pathein",
        "Monywa","Meiktila","Myitkyina","Sittwe","Pyay","Hpa-An","Magway","Dawei",
        "Lashio","Pakokku","Hinthada","Myingyan","Pyin Oo Lwin","Kalaw","Nyaung-U"
      ].forEach(function (c) { %><option value="<%= c %>"></option><% }) %>
    </datalist>

    <!-- popup: all delivery charges + search by location -->
    <div class="modal-overlay" id="dcModal" style="display:none">
      <div class="modal-box perf-modal-box">
        <div class="perf-modal-head">🚚 All delivery charges — <%= charges.length %></div>
        <div class="orders-toolbar" style="justify-content:flex-start;margin-bottom:.4rem;flex-wrap:wrap">
          <label class="ot-field">🔎 <input type="text" id="dcSearchInput" placeholder="Search location…" style="width:140px"></label>
          <label class="ot-field">From <input type="date" id="dcFrom"></label>
          <label class="ot-field">To <input type="date" id="dcTo"></label>
          <button type="button" class="btn sm gray" id="dcClear">Clear</button>
        </div>
        <div class="perf-modal-scroll">
          <form id="bulkDcAll" action="/admin/delivery-charges/bulk-delete" method="post" data-confirm="Delete the selected delivery charge(s)?"></form>
          <table class="tbl" id="dcTable">
            <thead><tr><th><input type="checkbox" class="bulk-all" data-group="dcAll" title="Select all"></th><th>No.</th><th>📍 Location</th><th>📅 Added</th><th style="text-align:center">Charge (Kyats)</th><th>Action</th></tr></thead>
            <tbody>
              <% charges.forEach((c, idx) => { var dd = c.created_at ? c.created_at.substring(0,10) : ""; %>
                <tr data-loc="<%= String(c.pincode).toLowerCase() %>" data-date="<%= dd %>">
                  <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="dcAll" name="dc_ids" value="<%= c.id %>" form="bulkDcAll"></td>
                  <td><strong><%= idx + 1 %></strong></td>
                  <td><%= c.pincode %></td>
                  <td class="muted"><%= dd || "—" %></td>
                  <td>
                    <form action="/admin/delivery-charges" method="post" class="inline" style="gap:.3rem">
                      <input type="hidden" name="pincode" value="<%= c.pincode %>">
                      <input name="charge_amount" type="text" inputmode="numeric" value="<%= c.charge_amount %>" style="width:75px"
                    oninput="this.value=this.value.replace(/[^0-9]/g,'')"> Kyats
                      <button class="btn sm" type="submit">Save</button>
                    </form>
                  </td>
                  <td>
                    <form action="/admin/delivery-charges/<%= c.id %>/delete" method="post" class="inline"
                          data-confirm="Delete delivery charge for <%= c.pincode %>?">
                      <button class="btn sm danger" type="submit">🗑</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="muted" id="dcNoRows" style="display:none;padding:.6rem">No matching location.</p>
        </div>
        <div class="acc-actions" style="margin-top:.7rem">
          <button class="btn sm danger" type="submit" form="bulkDcAll">🗑 Delete selected</button>
          <button type="button" class="btn" id="dcClose">Close</button>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var modal = document.getElementById("dcModal");
        if (!modal) return;
        var openBtn = document.getElementById("dcReadMore");
        function open() { modal.style.display = "flex"; }
        function close() { modal.style.display = "none"; }
        if (openBtn) openBtn.addEventListener("click", open);
        document.getElementById("dcClose").addEventListener("click", close);
        modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
        var input = document.getElementById("dcSearchInput");
        var from = document.getElementById("dcFrom"), to = document.getElementById("dcTo");
        var rows = Array.prototype.slice.call(document.querySelectorAll("#dcTable tbody tr"));
        var noRows = document.getElementById("dcNoRows");
        function applyFilter() {
          var q = (input.value || "").trim().toLowerCase(), f = from.value, t = to.value, shown = 0;
          rows.forEach(function (tr) {
            var loc = tr.getAttribute("data-loc") || "", d = tr.getAttribute("data-date") || "";
            var ok = (!q || loc.indexOf(q) !== -1)
                  && (!f || (d && d >= f)) && (!t || (d && d <= t));
            tr.style.display = ok ? "" : "none";
            if (ok) shown++; else { var cb = tr.querySelector(".bulk-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
          });
          var dcMaster = document.querySelector('.bulk-all[data-group="dcAll"]');
          if (dcMaster) dcMaster.checked = false;
          noRows.style.display = shown ? "none" : "";
        }
        input.addEventListener("input", applyFilter);
        from.addEventListener("change", applyFilter);
        to.addEventListener("change", applyFilter);
