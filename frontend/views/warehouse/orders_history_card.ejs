<%# Orders-history card — embedded on the Orders page (expects `orders` =
    shipped/delivered/cancelled list). Date search recomputes revenue + PDF link. %>
<div class="card">
  <h3>📦 <%= t("Orders History") %> <span class="muted">(<%= orders.length %>)</span> ·
    <%= t("Revenue") %> <span class="badge" id="ohTotal" style="font-size:1.15rem;padding:.3rem .7rem"><%= t("= {n} Kyats", { n: 0 }) %></span>
    <span class="muted" id="ohPeriodLabel" style="font-size:.85rem;font-weight:400"> · <%= t("all time") %></span></h3>
  <p class="muted" style="margin:.1rem 0 .6rem"><%= t("Your shipped, delivered & cancelled orders — filter by date to check your history & revenue.") %></p>

  <div class="orders-toolbar" style="justify-content:flex-start;margin:.3rem 0 .7rem;flex-wrap:wrap">
    <label class="ot-field">📅 <%= t("From") %> <input type="date" id="ohFrom"></label>
    <label class="ot-field">📅 <%= t("To") %> <input type="date" id="ohTo"></label>
    <button type="button" class="btn sm" id="ohSearch">🔍 <%= t("Search") %></button>
    <a class="btn sm" id="ohPdf" href="/warehouse/orders-history/pdf" target="_blank">📄 <%= t("Download PDF") %></a>
  </div>

  <p class="muted" id="ohCountLine" style="margin:.6rem 0"></p>

  <% if (!orders.length) { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <div class="empty-title"><%= t("No past orders") %></div>
      <div class="empty-sub"><%= t("Shipped orders will appear here.") %></div>
    </div>
  <% } else { %>
    <form id="bulkOh" action="/warehouse/orders/delete" method="post" data-confirm="<%= t("Delete the selected order(s) from your history? This permanently removes them.") %>"></form>
    <table class="tbl" id="ohTable">
      <thead><tr><th><input type="checkbox" class="bulk-all" data-group="oh" title="<%= t("Select all") %>"></th><th><%= t("No.") %></th><th>📅 <%= t("Date") %></th><th><%= t("Customer") %></th><th>📞 <%= t("Phone") %></th><th><%= t("Product") %></th><th><%= t("Price") %></th><th><%= t("Address") %></th><th><%= t("Total (Kyats)") %></th><th><%= t("Status") %></th><th><%= t("Message") %></th><th><%= t("Details") %></th></tr></thead>
      <tbody>
      <% orders.forEach((o) => { var od = o.created_at ? o.created_at.substring(0,10) : ""; %>
        <tr data-date="<%= od %>">
          <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="oh" name="order_ids" value="<%= o.id %>" form="bulkOh"></td>
          <td class="oh-no"></td>
          <td class="muted"><%= od || "—" %></td>
          <td><%= o.customer_name %></td>
          <td class="muted"><%= o.customer_phone || "—" %></td>
          <td><% o.items.forEach(function (it) { %><div><%= it.batch_id %></div><% }) %></td>
          <td><% o.items.forEach(function (it) { %><div><%= t("{n} Kyats", { n: it.unit_price }) %></div><% }) %></td>
          <td class="muted"><%= o.delivery_address %></td>
          <td><%= o.total_price %></td>
          <td class="status-flat"><%= whStatusLabel(o.status) %></td>
          <td><a class="btn sm" href="/warehouse/orders/<%= o.id %>/messages">💬</a></td>
          <td><a class="btn sm row-view" href="/warehouse/orders/<%= o.id %>/details">🔍 <%= t("View") %></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <div class="acc-actions"><button class="btn sm danger" type="submit" form="bulkOh">🗑 <%= t("Delete selected") %></button></div>
    <p class="muted" id="ohNoRows" style="display:none;padding:.6rem"><%= t("No orders in this date range.") %></p>
  <% } %>
</div>

<script>
  (function () {
    var data = <%- JSON.stringify((orders || []).map(function (o) { return { t: Number(o.total_price) || 0, d: o.created_at ? o.created_at.substring(0,10) : "", cancelled: (o.status === "cancelled") }; })) %>;
    var L = <%- JSON.stringify({
      eq: t("= {n} Kyats"), allTime: t("all time"), start: t("start"), now: t("now"),
      shownOne: t("{n} order shown"), shownMany: t("{n} orders shown"),
      revExcl: t("(revenue excludes cancelled)")
    }) %>;
    var totalEl = document.getElementById("ohTotal");
    var labelEl = document.getElementById("ohPeriodLabel");
    var countEl = document.getElementById("ohCountLine");
    var fromEl = document.getElementById("ohFrom");
    var toEl = document.getElementById("ohTo");
    if (!totalEl || !fromEl) return;
    var rows = Array.prototype.slice.call(document.querySelectorAll("#ohTable tbody tr"));
    var noRows = document.getElementById("ohNoRows");
    function inRange(d) {
      var from = fromEl.value, to = toEl.value;
      if (from && d && d < from) return false;
      if (to && d && d > to) return false;
      return true;
    }
    function render() {
      var total = 0, shown = 0;
      data.forEach(function (o) { if (!o.cancelled && o.d && inRange(o.d)) total += o.t; });
      total = Math.round(total);
      rows.forEach(function (tr) {
        var ok = inRange(tr.getAttribute("data-date") || "");
        tr.style.display = ok ? "" : "none";
        if (ok) { shown++; var no = tr.querySelector(".oh-no"); if (no) no.textContent = shown; }
        else { var cb = tr.querySelector(".bulk-cb"); if (cb) cb.checked = false; }  // hidden rows can't be submitted
      });
      var ohMaster = document.querySelector('.bulk-all[data-group="oh"]');
      if (ohMaster) ohMaster.checked = false;
      if (noRows) noRows.style.display = shown ? "none" : "";
      totalEl.textContent = L.eq.replace("{n}", total);
      var f = fromEl.value, t = toEl.value;
      // keep the PDF link in sync with the chosen date range
      var pdf = document.getElementById("ohPdf");
      if (pdf) {
        var q = [];
        if (f) q.push("from=" + encodeURIComponent(f));
        if (t) q.push("to=" + encodeURIComponent(t));
        pdf.href = "/warehouse/orders-history/pdf" + (q.length ? "?" + q.join("&") : "");
      }
      labelEl.textContent = " · " + ((f || t) ? ((f || L.start) + " → " + (t || L.now)) : L.allTime);
      countEl.innerHTML = (shown === 1 ? L.shownOne : L.shownMany).replace("{n}", "<strong>" + shown + "</strong>") + " <span class='muted'>" + L.revExcl + "</span>";
    }
    [fromEl, toEl].forEach(function (el) { el.addEventListener("change", render); });
    document.getElementById("ohSearch").addEventListener("click", render);
    render();
  })();
</script>
