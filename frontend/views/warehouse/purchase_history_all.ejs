<%- include("../partials/header") %>

<div class="page-intro">
  <span class="page-intro-ico">🧾</span>
  <div>
    <strong>Purchase history</strong>
    <span>Every package plan you've bought. Search by the date it started.</span>
  </div>
</div>

<div class="card">
  <form action="/warehouse/purchase-history-all" method="get" class="orders-toolbar">
    <label class="ot-field">From <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field">To <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 Search</button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/purchase-history-all">Clear</a><% } %>
    <a class="btn sm gray" href="/warehouse/subscription">← Back</a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <strong><%= history.length %></strong> purchase<%= history.length === 1 ? "" : "s" %><%
      if (from || to) { %> · started <%= from || "…" %> → <%= to || "…" %><% } %>
  </p>

  <% if (!history.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🧾</div>
      <div class="empty-title">No purchases found</div>
      <div class="empty-sub">Try a different date range.</div>
    </div>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>No.</th><th>Plan</th><th>📅 From</th><th>To</th><th>Paid (Kyats)</th><th>Status</th></tr></thead>
      <tbody>
        <% history.forEach((h, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= h.plan_name || "—" %></td>
            <td class="muted"><%= h.start_date %></td>
            <td><%= h.end_date %></td>
            <td><%= h.price_paid %></td>
            <td><span class="status status-<%= h.active ? 'delivered' : 'cancelled' %>"><%= h.active ? "active" : "expired" %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
