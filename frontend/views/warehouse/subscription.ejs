<%- include("../partials/header") %>
<%- include("../partials/pay_success_modal") %>
<h2>Package</h2>

<div class="card">
  <h3>Current status</h3>
  <% if (sub.active) { %>
    <div class="alert-card ok">
      <span class="alert-ico">✅</span>
      <div class="alert-body">
        <div class="alert-title">Package active</div>
        <div class="alert-text"><strong><%= sub.current.plan_name %></strong> · active until
          <strong><%= sub.current.end_date %></strong> · <%= sub.current.days_remaining %> day(s) left</div>
      </div>
    </div>
  <% } else if (sub.current) { %>
    <div class="alert-card warn">
      <span class="alert-ico">⏳</span>
      <div class="alert-body">
        <div class="alert-title">Package expired</div>
        <div class="alert-text">Your <strong><%= sub.current.plan_name %></strong> expired on
          <%= sub.current.end_date %>. Renew below to keep selling.</div>
      </div>
    </div>
  <% } else { %>
    <div class="alert-card danger">
      <span class="alert-ico">🚀</span>
      <div class="alert-body">
        <div class="alert-title">No package yet</div>
        <div class="alert-text">Pick a plan below to start listing your products and selling to customers.</div>
      </div>
    </div>
  <% } %>
</div>

<h3>Choose a plan</h3>
<%
  var rates = plans.map(function (p) { return p.price / p.duration_months; });
  var baseRate = rates.length ? Math.max.apply(null, rates) : 0;
  var maxMonths = plans.length ? Math.max.apply(null, plans.map(function (p) { return p.duration_months; })) : 0;
  var icons = { 1: "🌱", 2: "📦", 6: "⭐", 12: "👑" };
%>
<div class="plan-grid">
  <% plans.forEach(p => {
       var perMonth = p.price / p.duration_months;
       var savePct = baseRate > 0 ? Math.round((1 - (perMonth / baseRate)) * 100) : 0;
       var isBest = (p.duration_months === maxMonths);
       var icon = icons[p.duration_months] || "🗓️";
  %>
    <div class="plan-card <%= isBest ? 'plan-best' : '' %>">
      <% if (isBest) { %><div class="plan-ribbon">Best value</div><% } %>
      <div class="plan-icon"><%= icon %></div>
      <div class="plan-name"><%= p.name %></div>
      <div class="plan-dur"><%= p.duration_months %> month<%= p.duration_months > 1 ? "s" : "" %></div>
      <div class="plan-price"><%= p.price %> Kyats</div>
      <div class="plan-permo"><%= perMonth.toFixed(0) %> Kyats/mo<% if (savePct > 0) { %> · <span class="plan-save">save <%= savePct %>%</span><% } %></div>
      <a class="btn plan-btn" href="/warehouse/subscription/checkout?plan_id=<%= p.id %>">
        <%= sub.active ? "Extend / Buy" : "Choose plan" %>
      </a>
    </div>
  <% }) %>
</div>

<%
  // ONE combined "purchase & payment" list: each payment row carries the plan
  // period it bought. Purchases with no payment record (legacy/granted) are
  // appended as rows of their own so nothing disappears.
  var covered = {};
  (payments || []).forEach(function (p) { if (p.subscription_id) covered[p.subscription_id] = true; });
  var combined = (payments || []).map(function (p) {
    return { date: p.created_at ? p.created_at.substring(0,10) : "", plan: p.plan_name,
             from: p.start_date, to: p.end_date, amount: p.amount,
             method: p.method_label, reference: p.reference,
             active: p.sub_active, slip: p.id };
  });
  (sub.history || []).forEach(function (h) {
    if (!covered[h.id]) combined.push({ date: h.start_date, plan: h.plan_name,
      from: h.start_date, to: h.end_date, amount: h.price_paid,
      method: null, reference: null, active: h.active, slip: null });
  });
  combined.sort(function (a, b) { return String(b.date).localeCompare(String(a.date)); });
%>
<div class="card">
  <h3>Purchase &amp; payment history <span class="muted">(<%= combined.length %>)</span></h3>
  <% if (!combined.length) { %><p class="muted">No purchases yet — buy a plan above and it will be listed here.</p><% } else { %>
    <table class="tbl">
      <thead><tr><th>📅 Paid on</th><th>Plan</th><th>Valid from</th><th>Valid to</th><th>Amount (Kyats)</th><th>Method</th><th>Reference</th><th>Status</th><th>Slip</th></tr></thead>
      <tbody>
        <% combined.slice(0, 5).forEach(r => { %>
          <tr>
            <td class="muted"><%= r.date || "—" %></td>
            <td><strong><%= r.plan || "—" %></strong></td>
            <td class="muted"><%= r.from || "—" %></td>
            <td class="muted"><%= r.to || "—" %></td>
            <td><%= r.amount %></td>
            <td><%= r.method || "—" %></td>
            <td class="muted"><%= r.reference || "—" %></td>
            <td><span class="status status-<%= r.active ? 'delivered' : 'cancelled' %>"><%= r.active ? "active" : "expired" %></span></td>
            <td><% if (r.slip) { %><a class="btn sm" href="/warehouse/payments/<%= r.slip %>/slip" target="_blank">🧾 PDF</a><% } else { %><span class="muted">—</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (combined.length > 5) { %>
      <a class="btn sm" href="/warehouse/payment-history-all">🧾 Read more — view all <%= combined.length %> →</a>
    <% } else { %>
      <a class="btn sm" href="/warehouse/payment-history-all">View all · search by date →</a>
    <% } %>
  <% } %>
</div>

<%- include("../partials/footer") %>
