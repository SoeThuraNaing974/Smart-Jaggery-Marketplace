<%- include("../partials/header") %>
<%
  // "Ingredients: … \n\n Effectiveness: …" -> two editable fields (same shape the
  // admin category cards use, so both sides edit the same description format)
  function splitDesc(d) {
    d = d || "";
    var ing = "", eff = "";
    var mi = d.match(/Ingredients:\s*([\s\S]*?)(?:\n+\s*Effectiveness:|$)/i);
    var me = d.match(/Effectiveness:\s*([\s\S]*)$/i);
    if (mi) ing = (mi[1] || "").trim();
    if (me) eff = (me[1] || "").trim();
    if (!mi && !me && d.trim()) ing = d.trim();
    return { ing: ing, eff: eff };
  }
%>

<div class="page-intro">
  <span class="page-intro-ico">📦</span>
  <div>
    <strong><%= t("Current stock — all products") %></strong>
    <span><%= t("Every product in your warehouse. Search by the date it was added; update quality & price, upload photos, or remove items.") %></span>
  </div>
</div>

<% var whDelBack = "all"; %>
<%- include("../partials/wh_deleted_alert") %>

<div class="card">
  <form action="/warehouse/stock-all" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/stock-all"><%= t("Clear") %></a><% } %>
    <a class="btn sm gray" href="/warehouse">← <%= t("Back to home") %></a>
  </form>

  <% if (typeof newCount !== "undefined" && newCount > 0) { %>
    <div class="new-cat-banner">
      <span class="ncb-ico">🎉</span>
      <span class="ncb-text"><%= t(newCount === 1
        ? "{n} new category just added to your warehouse — highlighted below with a ✨ NEW tag."
        : "{n} new categories just added to your warehouse — highlighted at the top with a ✨ NEW tag.", { n: newCount }) %></span>
    </div>
  <% } %>

  <p class="muted" style="margin:.6rem 0">
    <%= t(batches.length === 1 ? "{n} product" : "{n} products", { n: batches.length }) %><%
      if (from || to) { %> · <%= t("added {from} → {to}", { from: from || "…", to: to || "…" }) %><% } %>
  </p>

  <% if (!batches.length) { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <div class="empty-title"><%= t("No products found") %></div>
      <div class="empty-sub"><%= t("Try a different date range.") %></div>
    </div>
  <% } else { %>
    <div class="cat-grid">
      <% batches.forEach(b => { const fid = "wf" + b.id; const dd = splitDesc(b.description); %>
        <div class="cat-card <%= b.expired ? 'expired' : '' %>">
          <div class="cat-top">
            <div class="cat-thumb">
              <% if (b.image_path) { %>
                <img src="/uploads/<%= b.image_path %>" alt="jaggery">
              <% } else { %>
                <span class="cat-noimg"><%= t("No image") %></span>
              <% } %>
            </div>
            <div class="cat-meta">
              <strong class="cat-name"><%= b.batch_id %>
                <% if (b.isNew) { %><span class="new-tag">✨ <%= t("NEW") %></span><% } %></strong>
              <span class="status status-<%= b.expiry_status === 'expired' ? 'cancelled' : (b.expiry_status === 'near_expiry' ? 'pending' : 'delivered') %>"><%= t(b.expiry_status) %></span>
            </div>
          </div>

          <% if (b.images && b.images.length) { %>
            <div class="cat-imgs">
              <% b.images.forEach(im => { %>
                <span class="cat-img-thumb">
                  <img src="/uploads/<%= im.image_path %>" alt="extra photo">
                  <form action="/warehouse/batches/<%= b.id %>/images/<%= im.id %>/delete" method="post" data-confirm="<%= t("Remove this photo?") %>">
                    <button class="cat-img-x" type="submit" title="<%= t("Remove photo") %>">✕</button>
                  </form>
                </span>
              <% }) %>
            </div>
          <% } %>

          <form id="<%= fid %>" action="/warehouse/batches/<%= b.id %>/update" method="post" class="cat-fields">
            <input type="hidden" name="_back" value="all">
            <label style="grid-column:1 / -1"><%= t("Name") %><input name="batch_id" type="text" value="<%= b.batch_id %>" required></label>
            <label><%= t("Grade") %>
              <select name="grade">
                <% ["A","B","C"].forEach(g => { %><option <%= b.grade === g ? "selected" : "" %>><%= g %></option><% }) %>
              </select>
            </label>
            <label><%= t("Qty (kg)") %><input name="qty_kg" type="number" step="0.5" value="<%= b.qty_kg %>"></label>
            <label><%= t("Kyats/kg") %><input name="price_per_kg" type="number" step="0.5" value="<%= b.price_per_kg %>"></label>
            <label><%= t("Production date") %><input name="harvest_date" type="date" value="<%= b.harvest_date %>"></label>
            <div class="desc-edit">
              <div class="de-col">
                <span class="de-head">🧪 <%= t("Ingredients") %></span>
                <input type="text" name="ingredients" class="de-input" value="<%= dd.ing %>" placeholder="<%= t("e.g. pure sugarcane juice") %>">
              </div>
              <div class="de-col">
                <span class="de-head">💪 <%= t("Effectiveness") %></span>
                <input type="text" name="effectiveness" class="de-input" value="<%= dd.eff %>" placeholder="<%= t("e.g. rich in iron, aids digestion") %>">
              </div>
              <button type="button" class="de-more" data-form="<%= fid %>" data-name="<%= b.batch_id %>"><%= t("See more & edit") %> ⤢</button>
            </div>
          </form>

          <p class="muted cat-date" style="white-space:nowrap">📅 <%= t("Added: {a} · Production: {p}", { a: b.created_at ? b.created_at.substring(0,10) : "—", p: b.harvest_date ? b.harvest_date.substring(0,10) : "—" }) %></p>
          <% if (b.certificate_path) { %><p class="muted" style="margin:.1rem 0">✔ <%= t("Certificate on file") %></p><% } %>

          <div class="cat-toolbar">
            <form action="/warehouse/batches/<%= b.id %>/image" method="post" enctype="multipart/form-data" class="ct-form">
              <label class="btn sm btn-outline upl-label" title="<%= t("Set the cover photo") %>">⬆ <%= t("Cover") %>
                <input type="file" name="file" accept="image/*" class="js-img-input" onchange="if(!window.__inplaceImage)this.closest('form').submit()">
              </label>
            </form>
            <form action="/warehouse/batches/<%= b.id %>/images" method="post" enctype="multipart/form-data" class="ct-form">
              <label class="btn sm btn-outline upl-label" title="<%= t("Add more photos") %>">➕ <%= t("Photos") %>
                <input type="file" name="files" accept="image/*" multiple onchange="this.closest('form').submit()">
              </label>
            </form>
            <form action="/warehouse/batches/<%= b.id %>/image/remove" method="post" class="ct-form" data-confirm="<%= t("Remove the cover photo?") %>">
              <button class="btn sm btn-outline" type="submit" <%= b.image_path ? "" : "disabled" %>><%= t("Remove image") %></button>
            </form>
            <span class="spacer"></span>
            <button class="btn sm" type="submit" form="<%= fid %>"><%= t("Save") %></button>
            <form action="/warehouse/batches/<%= b.id %>/delete" method="post" class="ct-form"
                  data-confirm="<%= t("Delete category {name}? It will be removed from the shop and the admin notified.", { name: b.batch_id }) %>">
              <input type="hidden" name="_back" value="all">
              <button class="btn sm danger" type="submit"><%= t("Delete") %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/desc_edit_modal") %>
<%- include("../partials/footer") %>
