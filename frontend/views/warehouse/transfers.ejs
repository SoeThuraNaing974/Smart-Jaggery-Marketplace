<%- include("../partials/header") %>
<h2>Request</h2>

<% if (typeof submitted !== "undefined" && submitted) { %>
<div class="modal-overlay" id="reqModal">
  <div class="modal-box">
    <div class="modal-check">✓</div>
    <h3 class="modal-title">Request submitted!</h3>
    <p class="modal-text">Your product has been sent to the admin for approval.
      Once approved, it goes live on the <strong>Categories</strong> page for customers to buy.</p>
    <button class="btn" id="reqModalClose">Got it</button>
  </div>
</div>
<script>
  (function () {
    var m = document.getElementById("reqModal");
    function close() {
      m.style.display = "none";
      if (history.replaceState) history.replaceState({}, "", "/warehouse/transfers");
    }
    document.getElementById("reqModalClose").addEventListener("click", close);
    m.addEventListener("click", function (e) { if (e.target === m) close(); });
  })();
</script>
<% } %>

<div class="card">
  <h3>Request a new product</h3>
  <p class="req-hint">🛍️ Add your product and send it to the admin for review — once approved, it goes <strong>live on the Categories page</strong> for customers to buy.</p>
  <% if (subscribed) { %>
    <form action="/warehouse/product-requests" method="post" enctype="multipart/form-data" class="row-form">
      <input name="product_name" placeholder="Product name" required>
      <select name="grade"><option>A</option><option>B</option><option>C</option></select>
      <input name="qty_kg" type="text" inputmode="decimal" placeholder="Amount (kg)" required
             oninput="this.value=this.value.replace(/[^0-9.]/g,'').replace(/(\..*)\./g,'$1')">
      <input name="price_per_kg" type="text" inputmode="numeric" placeholder="Price Kyats/kg" required
             title="Whole numbers only" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
      <input name="harvest_date" type="date" required>
      <label class="upl-label btn sm btn-outline" title="Add one or more product photos">📷 Add photos
        <input type="file" name="files" accept="image/*" multiple hidden
               onchange="document.getElementById('reqFileHint').textContent = this.files.length ? (this.files.length + ' photo(s) selected') : 'No photos selected';">
      </label>
      <span class="muted file-hint" id="reqFileHint">No photos selected</span>
      <div class="desc-split">
        <label class="desc-col">
          <span class="desc-col-head">🧪 Ingredients</span>
          <input type="text" name="ingredients" maxlength="200"
                 placeholder="e.g. pure sugarcane juice, no additives">
        </label>
        <label class="desc-col">
          <span class="desc-col-head">💪 Effectiveness</span>
          <input type="text" name="effectiveness" maxlength="200"
                 placeholder="e.g. rich in iron, boosts energy, aids digestion">
        </label>
      </div>
      <button class="btn sm" type="submit" style="margin-top:.2rem">Request product</button>
    </form>
  <% } else { %>
    <div class="alert err">⚠ You need an active package to request products.
      <a href="/warehouse/subscription"><strong>Buy a plan</strong></a>.</div>
  <% } %>

  <% if (productRequests && productRequests.length) { %>
    <h4 style="margin-top:2.2rem">My product requests <span class="muted">(<%= productRequests.length %>)</span></h4>
    <table class="tbl">
      <thead><tr><th>Image</th><th>Product</th><th>Grade</th><th>Amount</th><th>Price (Kyats)</th><th>Status</th><th>Admin's Note</th></tr></thead>
      <tbody>
        <% productRequests.slice(0, 3).forEach(r => { %>
          <tr>
            <td><% if (r.image_path) { %><img src="<%= apiBase %>/uploads/<%= r.image_path %>" alt="" class="thumb"><% } else { %><span class="muted">—</span><% } %></td>
            <td><%= r.product_name %></td><td><%= r.grade %></td><td><%= r.qty_kg %></td><td><%= r.price_per_kg %></td>
            <td><span class="status status-<%= r.status === 'approved' ? 'delivered' : (r.status === 'pending' ? 'pending' : 'cancelled') %>"><%= r.status %></span></td>
            <td>
              <% if (r.admin_note) { %>
                <div class="note-wrap">
                  <span class="note-prev"><%= r.admin_note %></span>
                  <% if (r.admin_note.length > 30) { %>
                    <button type="button" class="note-more" data-note="<%= r.admin_note %>">📄 Read more</button>
                  <% } %>
                </div>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (productRequests.length > 3) { %>
      <a class="btn sm" href="/warehouse/product-requests-all">📦 Read more — view all <%= productRequests.length %> requests →</a>
    <% } else { %>
      <a class="btn sm" href="/warehouse/product-requests-all">View all · search by date →</a>
    <% } %>

    <!-- full admin-note popup (for long notes) -->
    <div id="noteModal" class="modal-overlay" style="display:none">
      <div class="modal-box note-modal-box">
        <button type="button" class="otp-close" id="noteModalClose">✕</button>
        <div class="note-modal-head"><span class="note-modal-ico">📝</span> Admin's note</div>
        <p id="noteModalBody" class="note-modal-body"></p>
        <button type="button" class="btn" id="noteModalOk" style="width:100%">Got it</button>
      </div>
    </div>
    <script>
      (function () {
        var modal = document.getElementById("noteModal"), body = document.getElementById("noteModalBody");
        if (!modal) return;
        function close() { modal.style.display = "none"; }
        document.querySelectorAll(".note-more").forEach(function (b) {
          b.addEventListener("click", function () { body.textContent = b.dataset.note || ""; modal.style.display = "flex"; });
        });
        document.getElementById("noteModalClose").addEventListener("click", close);
        document.getElementById("noteModalOk").addEventListener("click", close);
        modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
      })();
    </script>
  <% } %>
</div>

<div class="card">
  <h3>Transfer history <span class="muted">(<%= transfers.length %>)</span></h3>
  <% if (!transfers.length) { %><p class="muted">No transfers yet.</p><% } %>
  <table class="tbl">
    <thead><tr><th>No.</th><th>Category</th><th>From → To</th><th>Qty</th><th>Status</th><th>Requested</th></tr></thead>
    <tbody>
    <% transfers.slice(0, 3).forEach((t, idx) => { %>
      <tr>
        <td><%= idx + 1 %></td>
        <td><%= t.batch_code %></td>
        <td><%= t.from_warehouse %> → <%= t.to_warehouse %></td>
        <td><%= t.quantity_kg %></td>
        <td><span class="status status-<%= t.status === 'completed' ? 'delivered' : (t.status === 'pending' ? 'pending' : 'cancelled') %>"><%= t.status %></span></td>
        <td class="muted"><%= t.requested_at ? t.requested_at.substring(0,10) : "" %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% if (transfers.length > 3) { %>
    <a class="btn sm" href="/warehouse/transfers-all">🔄 Read more — view all <%= transfers.length %> transfers →</a>
  <% } else if (transfers.length) { %>
    <a class="btn sm" href="/warehouse/transfers-all">View all · search by date →</a>
  <% } %>
</div>
<%- include("../partials/footer") %>
