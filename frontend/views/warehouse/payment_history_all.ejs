<%- include("../partials/header") %>

<div class="page-intro">
  <span class="page-intro-ico">🧾</span>
  <div>
    <strong><%= t("Purchase & payment history") %></strong>
    <span><%= t("Every subscription you've bought and the payment that covered it — search by the date it was paid.") %></span>
  </div>
</div>

<div class="card">
  <form action="/warehouse/payment-history-all" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/payment-history-all"><%= t("Clear") %></a><% } %>
    <a class="btn sm gray" href="/warehouse/subscription">← <%= t("Back") %></a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <%= t(rows.length === 1 ? "{n} purchase" : "{n} purchases", { n: rows.length }) %><%
      if (from || to) { %> · <%= t("paid {from} → {to}", { from: from || "…", to: to || "…" }) %><% } %>
  </p>

  <% if (!rows.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🧾</div>
      <div class="empty-title"><%= t("No purchases found") %></div>
      <div class="empty-sub"><%= t("Try a different date range.") %></div>
    </div>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th><%= t("No.") %></th><th>📅 <%= t("Paid on") %></th><th><%= t("Plan") %></th><th><%= t("Valid from") %></th><th><%= t("Valid to") %></th><th><%= t("Amount (Kyats)") %></th><th><%= t("Method") %></th><th><%= t("Reference") %></th><th><%= t("Status") %></th><th><%= t("Slip") %></th></tr></thead>
      <tbody>
        <% rows.forEach((r, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td class="muted"><%= r.date || "—" %></td>
            <td><strong><%= r.plan || "—" %></strong></td>
            <td class="muted"><%= r.from || "—" %></td>
            <td class="muted"><%= r.to || "—" %></td>
            <td><%= r.amount %></td>
            <td><%= r.method || "—" %></td>
            <td class="muted"><%= r.reference || "—" %></td>
            <td><span class="status status-<%= r.active ? 'delivered' : 'cancelled' %>"><%= t(r.active ? "active" : "expired") %></span></td>
            <td><% if (r.slip) { %><a class="btn sm" href="/warehouse/payments/<%= r.slip %>/slip" target="_blank">🧾 PDF</a><% } else { %><span class="muted">—</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
