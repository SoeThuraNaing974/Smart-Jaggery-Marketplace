<%- include("../partials/header") %>

<div class="page-intro">
  <span class="page-intro-ico">🧾</span>
  <div>
    <strong>Purchase &amp; payment history</strong>
    <span>Every package you've bought and the payment that covered it — search by the date it was paid.</span>
  </div>
</div>

<div class="card">
  <form action="/warehouse/payment-history-all" method="get" class="orders-toolbar">
    <label class="ot-field">From <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field">To <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 Search</button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/payment-history-all">Clear</a><% } %>
    <a class="btn sm gray" href="/warehouse/subscription">← Back</a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <strong><%= rows.length %></strong> purchase<%= rows.length === 1 ? "" : "s" %><%
      if (from || to) { %> · paid <%= from || "…" %> → <%= to || "…" %><% } %>
  </p>

  <% if (!rows.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🧾</div>
      <div class="empty-title">No purchases found</div>
      <div class="empty-sub">Try a different date range.</div>
    </div>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>No.</th><th>📅 Paid on</th><th>Plan</th><th>Valid from</th><th>Valid to</th><th>Amount (Kyats)</th><th>Method</th><th>Reference</th><th>Status</th><th>Slip</th></tr></thead>
      <tbody>
        <% rows.forEach((r, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td class="muted"><%= r.date || "—" %></td>
            <td><strong><%= r.plan || "—" %></strong></td>
            <td class="muted"><%= r.from || "—" %></td>
            <td class="muted"><%= r.to || "—" %></td>
            <td><%= r.amount %></td>
            <td><%= r.method || "—" %></td>
            <td class="muted"><%= r.reference || "—" %></td>
            <td><span class="status status-<%= r.active ? 'delivered' : 'cancelled' %>"><%= r.active ? "active" : "expired" %></span></td>
            <td><% if (r.slip) { %><a class="btn sm" href="/warehouse/payments/<%= r.slip %>/slip" target="_blank">🧾 PDF</a><% } else { %><span class="muted">—</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
