<%- include("../partials/header") %>

<div class="page-intro">
  <span class="page-intro-ico">🔄</span>
  <div>
    <strong><%= t("Transfer history") %></strong>
    <span><%= t("Every stock transfer involving your warehouse. Search by the date it was requested.") %></span>
  </div>
</div>

<div class="card">
  <form action="/warehouse/transfers-all" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/transfers-all"><%= t("Clear") %></a><% } %>
    <a class="btn sm gray" href="/warehouse/transfers">← <%= t("Back") %></a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <%= t(transfers.length === 1 ? "{n} transfer" : "{n} transfers", { n: transfers.length }) %><%
      if (from || to) { %> · <%= t("requested {from} → {to}", { from: from || "…", to: to || "…" }) %><% } %>
  </p>

  <% if (!transfers.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🔄</div>
      <div class="empty-title"><%= t("No transfers found") %></div>
      <div class="empty-sub"><%= t("Try a different date range.") %></div>
    </div>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th><%= t("No.") %></th><th>📅 <%= t("Requested") %></th><th><%= t("Category") %></th><th><%= t("From → To") %></th><th><%= t("Qty") %></th><th><%= t("Status") %></th></tr></thead>
      <tbody>
      <% transfers.forEach((tr, idx) => { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td class="muted"><%= tr.requested_at ? tr.requested_at.substring(0,10) : "—" %></td>
          <td><%= tr.batch_code %></td>
          <td><%= tr.from_warehouse %> → <%= tr.to_warehouse %></td>
          <td><%= tr.quantity_kg %></td>
          <td><span class="status status-<%= tr.status === 'completed' ? 'delivered' : (tr.status === 'pending' ? 'pending' : 'cancelled') %>"><%= t(tr.status) %></span></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
