<%- include("../partials/header") %>

<div class="page-intro">
  <span class="page-intro-ico">📦</span>
  <div>
    <strong><%= t("My product requests") %></strong>
    <span><%= t("Every product you've submitted for admin approval. Search by the date you requested it.") %></span>
  </div>
</div>

<div class="card">
  <form action="/warehouse/product-requests-all" method="get" class="orders-toolbar">
    <label class="ot-field"><%= t("From") %> <input type="date" name="from" value="<%= from %>"></label>
    <label class="ot-field"><%= t("To") %> <input type="date" name="to" value="<%= to %>"></label>
    <button class="btn sm" type="submit">🔍 <%= t("Search") %></button>
    <% if (from || to) { %><a class="btn sm gray" href="/warehouse/product-requests-all"><%= t("Clear") %></a><% } %>
    <a class="btn sm gray" href="/warehouse/transfers">← <%= t("Back") %></a>
  </form>

  <p class="muted" style="margin:.6rem 0">
    <%= t(productRequests.length === 1 ? "{n} request" : "{n} requests", { n: productRequests.length }) %><%
      if (from || to) { %> · <%= t("requested {from} → {to}", { from: from || "…", to: to || "…" }) %><% } %>
  </p>

  <% if (!productRequests.length) { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <div class="empty-title"><%= t("No product requests found") %></div>
      <div class="empty-sub"><%= t("Try a different date range.") %></div>
    </div>
  <% } else { %>
    <form id="bulkReq" action="/warehouse/product-requests/delete" method="post" data-confirm="<%= t("Delete the selected request(s)? This only removes them from your list.") %>"></form>
    <table class="tbl">
      <thead><tr><th><input type="checkbox" class="bulk-all" data-group="req" title="<%= t("Select all") %>"></th><th><%= t("No.") %></th><th>📅 <%= t("Requested") %></th><th><%= t("Image") %></th><th><%= t("Product") %></th><th><%= t("Grade") %></th>
        <th><%= t("Amount") %></th><th><%= t("Price (Kyats)") %></th><th><%= t("Status") %></th><th><%= t("Admin's Note") %></th></tr></thead>
      <tbody>
        <% productRequests.forEach((r, i) => { %>
          <tr>
            <td class="dir-chk"><input type="checkbox" class="bulk-cb" data-group="req" name="request_ids" value="<%= r.id %>" form="bulkReq"></td>
            <td><%= i + 1 %></td>
            <td class="muted"><%= r.created_at ? r.created_at.substring(0,10) : "—" %></td>
            <td><% if (r.image_path) { %><img src="<%= apiBase %>/uploads/<%= r.image_path %>" alt="" class="thumb"><% } else { %><span class="muted">—</span><% } %></td>
            <td><%= r.product_name %></td><td><%= r.grade %></td><td><%= r.qty_kg %></td><td><%= r.price_per_kg %></td>
            <td><span class="status status-<%= r.status === 'approved' ? 'delivered' : (r.status === 'pending' ? 'pending' : 'cancelled') %>"><%= t(r.status) %></span></td>
            <td>
              <% if (r.admin_note) { %>
                <div class="note-wrap">
                  <span class="note-prev"><%= r.admin_note %></span>
                  <% if (r.admin_note.length > 30) { %>
                    <button type="button" class="note-more" data-note="<%= r.admin_note %>">📄 <%= t("Read more") %></button>
                  <% } %>
                </div>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="acc-actions"><button class="btn sm danger" type="submit" form="bulkReq">🗑 <%= t("Delete selected") %></button></div>

    <!-- full admin-note popup (for long notes) -->
    <div id="noteModal" class="modal-overlay" style="display:none">
      <div class="modal-box note-modal-box">
        <button type="button" class="otp-close" id="noteModalClose">✕</button>
        <div class="note-modal-head"><span class="note-modal-ico">📝</span> <%= t("Admin's note") %></div>
        <p id="noteModalBody" class="note-modal-body"></p>
        <button type="button" class="btn" id="noteModalOk" style="width:100%"><%= t("Got it") %></button>
      </div>
    </div>
    <script>
      (function () {
        var modal = document.getElementById("noteModal"), body = document.getElementById("noteModalBody");
        if (!modal) return;
        function close() { modal.style.display = "none"; }
        document.querySelectorAll(".note-more").forEach(function (b) {
          b.addEventListener("click", function () { body.textContent = b.dataset.note || ""; modal.style.display = "flex"; });
        });
        document.getElementById("noteModalClose").addEventListener("click", close);
        document.getElementById("noteModalOk").addEventListener("click", close);
        modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
      })();
    </script>
  <% } %>
</div>

<%- include("../partials/footer") %>
