<%- include("../partials/header") %>

<!-- summary banner -->
<div class="card od-banner">
  <div class="od-banner-main">
    <div class="od-num">🧾 <%= t("Order") %></div>
    <div class="od-meta"><%= t("Placed on {d}", { d: order.created_at ? order.created_at.substring(0,10) : "—" }) %>
      · <%= t(order.items.length === 1 ? "{n} item" : "{n} items", { n: order.items.length }) %>
      · <strong><%= order.customer_name %></strong></div>
  </div>
  <div class="od-banner-side">
    <span class="od-status-pill status-<%= order.status %>"><%= whStatusLabel(order.status) %></span>
    <% if (order.payment_status === "paid") { %>
      <span class="pay-badge paid">✔ <%= t("Paid") %><% if (order.payment_method_label) { %> · <%= order.payment_method_label %><% } %></span>
    <% } else if (order.payment_method === "cod") { %>
      <span class="pay-badge cod"><%= t("Pay on delivery") %></span>
    <% } else { %>
      <span class="pay-badge unpaid"><%= t("Unpaid") %></span>
    <% } %>
  </div>
</div>

<div class="cols">
  <!-- customer & delivery -->
  <div class="card">
    <h3>👤 <%= t("Customer & delivery") %></h3>
    <dl class="od-dl">
      <div><dt><%= t("Customer") %></dt><dd><%= order.customer_name %></dd></div>
      <div><dt><%= t("Phone") %></dt><dd><%= order.customer_phone || "—" %></dd></div>
      <div><dt><%= t("Address") %></dt><dd><%= order.delivery_address || "—" %></dd></div>
      <div><dt><%= t("Voucher No.") %></dt><dd>VCH-<%= String(order.id).padStart(5, "0") %></dd></div>
      <div><dt><%= t("Preferred date") %></dt><dd><%= order.preferred_date || "—" %></dd></div>
      <div><dt><%= t("Warehouse") %></dt><dd><%= order.warehouse_name || "—" %></dd></div>
    </dl>
  </div>
  <!-- payment -->
  <div class="card">
    <h3>💳 <%= t("Payment") %></h3>
    <dl class="od-dl">
      <div><dt><%= t("Method") %></dt><dd><%= order.payment_method_label || order.payment_method || "—" %></dd></div>
      <div><dt><%= t("Status") %></dt><dd><%= order.payment_status ? t(order.payment_status) : "—" %></dd></div>
      <div><dt><%= t("Reference") %></dt><dd><%= order.payment_reference || "—" %></dd></div>
      <div><dt><%= t("Payment phone") %></dt><dd><%= order.payment_phone || "—" %></dd></div>
    </dl>
  </div>
</div>

<!-- items -->
<div class="card">
  <h3>📦 <%= t("Items") %><% if (order.partial) { %> <span class="muted" style="font-size:.8rem;font-weight:400"><%= t("(your items only)") %></span><% } %></h3>
  <table class="tbl">
    <thead><tr><th><%= t("No.") %></th><th><%= t("Product") %></th><th><%= t("Grade") %></th><th><%= t("Qty (kg)") %></th><th><%= t("Unit (Kyats)") %></th><th><%= t("Line Kyats") %> </th></tr></thead>
    <tbody>
      <% order.items.forEach(function (it, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= it.batch_id %></strong></td>
          <td><%= it.grade %></td>
          <td><%= it.qty_kg %></td>
          <td><%= t("{n} Kyats", { n: it.unit_price }) %></td>
          <td><%= t("{n} Kyats", { n: it.line_total }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="od-totals">
    <div><span><%= t("Subtotal") %></span><span><%= t("{n} Kyats", { n: order.subtotal }) %></span></div>
    <% if (order.discount_amount && Number(order.discount_amount) > 0) { %>
      <div class="od-disc"><span><%= t("Discount") %></span><span>− <%= t("{n} Kyats", { n: order.discount_amount }) %></span></div>
    <% } %>
    <div><span><%= t("Delivery") %></span><span><%= t("{n} Kyats", { n: order.delivery_charge }) %></span></div>
    <div class="od-grand"><span><%= t("Total") %></span><span><%= t("{n} Kyats", { n: order.grand_total != null ? order.grand_total : order.total_price }) %></span></div>
  </div>
</div>

<!-- actions -->
<div class="card od-actions">
  <% if (order.status === "assigned") { %>
    <form action="/warehouse/orders/<%= order.id %>/status" method="post" class="inline">
      <input type="hidden" name="status" value="packed">
      <button class="btn" type="submit"><%= t("Waiting") %></button>
    </form>
  <% } else if (order.status === "packed") { %>
    <form action="/warehouse/orders/<%= order.id %>/status" method="post" class="inline">
      <input type="hidden" name="status" value="shipped">
      <button class="btn danger" type="submit"><%= t("Shipped") %></button>
    </form>
  <% } %>
  <a class="btn" href="/warehouse/orders/<%= order.id %>/messages">💬 <%= t("Message customer") %></a>
  <a class="btn gray" href="/warehouse">← <%= t("Back to home") %></a>
</div>

<%- include("../partials/footer") %>
