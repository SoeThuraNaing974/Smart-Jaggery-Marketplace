<%- include("partials/header") %>
<h2><%= t("My Profile") %></h2>

<div class="card">
  <h3><%= t("Profile picture") %></h3>
  <div class="avatar-row">
    <% if (profile.avatar_path) { %>
      <img class="avatar-lg" src="<%= apiBase %>/uploads/<%= profile.avatar_path %>" alt="<%= t("Profile picture") %>">
    <% } else { %>
      <span class="avatar-lg avatar-ph"><%= (profile.name || '?').trim().charAt(0).toUpperCase() %></span>
    <% } %>
    <div>
      <form action="/profile/avatar" method="post" enctype="multipart/form-data">
        <input type="file" name="file" accept="image/*" required>
        <button class="btn sm" type="submit"><%= t("Upload photo") %></button>
      </form>
      <% if (profile.avatar_path) { %>
        <form action="/profile/avatar/remove" method="post" style="margin-top:.4rem"
              data-confirm="<%= t("Remove your profile picture?") %>">
          <button class="link-btn danger" type="submit"><%= t("Remove photo") %></button>
        </form>
      <% } %>
      <p class="muted"><%= t("JPG, PNG, GIF or WEBP.") %></p>
    </div>
  </div>
</div>

<div class="cols">
  <div class="card">
    <h3><%= t("Details") %></h3>
    <form action="/profile" method="post">
      <label><%= t("Name") %>: <input name="name" value="<%= profile.name || '' %>" required></label>
      <label><%= t("Email") %>: <input value="<%= profile.email || '' %>" readonly
             style="color:#333;-webkit-text-fill-color:#333;opacity:1;background:#fff"></label>
      <%
        var savedPhone = (profile.phone || '').trim();
        var ccCodes = ["+880","+977","+95","+66","+91","+65","+60","+86","+44","+61","+81","+82","+84","+62","+63","+1"];
        var ccSel = "+95"; var localPhone = savedPhone.replace(/\D/g, '');
        for (var i = 0; i < ccCodes.length; i++) {
          if (savedPhone.indexOf(ccCodes[i]) === 0) { ccSel = ccCodes[i]; localPhone = savedPhone.slice(ccCodes[i].length).replace(/\D/g, ''); break; }
        }
      %>
      <label><%= t("Phone Number") %>:</label>
      <div class="phone-group">
        <select name="country_code" class="phone-cc-select"><%- include("partials/ccodes", { selected: ccSel }) %></select>
        <input name="phone" type="tel" inputmode="numeric" value="<%= localPhone %>"
               maxlength="12" pattern="[0-9]{1,12}" title="<%= t("Phone number") %>">
      </div>
      <label><%= t("Address") %>: <input name="address" value="<%= profile.address || '' %>"></label>
      <label><%= t("State") %>: <span class="muted"><%= t("(optional)") %></span>
        <input name="pincode" list="mmStates" value="<%= profile.pincode || '' %>"
               autocomplete="off" placeholder="<%= t("Start typing a state…") %>">
      </label>
      <datalist id="mmStates">
        <% [
          "Kachin","Kayah","Kayin","Chin","Mon","Rakhine","Shan",
          "Sagaing","Tanintharyi","Bago","Magway","Mandalay","Yangon","Ayeyarwady",
          "Naypyitaw"
        ].forEach(function(s){ %>
          <option value="<%= s %>"></option>
        <% }) %>
      </datalist>
      <button class="btn" type="submit"><%= t("Save changes") %></button>
    </form>
  </div>

  <div class="card">
    <h3><%= t("Change password") %></h3>
    <form action="/change-password" method="post">
      <label><%= t("Current password") %> <input type="password" name="current_password" required></label>
      <label><%= t("New password") %> <input type="password" name="new_password" minlength="6" required></label>
      <button class="btn" type="submit"><%= t("Update password") %></button>
    </form>
    <p class="muted"><%= t("Role") %>: <%= profile.role %></p>
  </div>
</div>
<%- include("partials/footer") %>
