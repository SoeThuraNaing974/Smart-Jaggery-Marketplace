<%- include("../partials/header") %>

<%# The admin lands here from the grade-descriptions editor ("view the page") —
    a back arrow returns them straight to that editor. Customers never see it. %>
<% if (user && user.role === "admin") { %>
  <a class="btn sm gray" style="margin-bottom:.7rem;display:inline-flex;align-items:center;gap:.35rem"
     href="/admin/grade-edit"><span aria-hidden="true" style="font-size:1.05em">←</span> <%= t("Back") %></a>
<% } %>

<% if (promotions.length) { %>
<div class="card promo">
  <h3>🎉 <%= t("Active promotions") %></h3>
  <div class="promo-ticker" aria-label="<%= t("Active promotions") %>">
    <div class="promo-ticker-move">
      <% for (var pk = 0; pk < 2; pk++) { %>
        <% promotions.forEach(p => { %>
          <span class="promo-ticker-item">🎉 <strong><%= p.title %></strong>
            <span class="muted">(<%= t("from {s} to {e}", { s: p.start_date, e: p.end_date }) %>)</span></span>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
<% } %>

<% if (!user) { %>
  <div class="guest-note">
    <span class="guest-note-ico">🔒</span>
    <span class="guest-note-txt"><strong><%= t("You're browsing as a guest.") %></strong>
      <%= t("Prices and stock are live — sign in to add anything to your cart.") %></span>
    <a class="btn sm" href="/login?next=%2Fbatches"><%= t("Sign in to order") %></a>
  </div>
<% } %>

<h2><%= t("Jaggery Categories") %></h2>

<div class="grade-filter">
  <span class="muted"><%= t("Filter by grade:") %></span>
  <a class="grade-chip <%= !selectedGrade ? 'active' : '' %>" href="/batches"><%= t("All") %></a>
  <% ["A","B","C"].forEach(g => { %>
    <a class="grade-chip grade-<%= g %> <%= selectedGrade === g ? 'active' : '' %>" href="/batches?grade=<%= g %>"><%= t("Grade {g}", { g: g }) %></a>
  <% }) %>
</div>

<%
  // Built-in grade descriptions come from lib/gradeInfo.js (translated via t());
  // the admin can override any field from /admin/grade-edit — overrides are
  // shown as saved, in both languages. Strengths/weaknesses are one item per line.
  var gi = selectedGrade && gradeInfo[selectedGrade];
  var gc = (typeof gradeContent !== "undefined" && gradeContent) ? gradeContent : {};
  var gv = null;
  if (gi) {
    var gk = selectedGrade.toLowerCase();
    var lines = function (txt) {
      return String(txt).split(/\r?\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    };
    gv = {
      icon: gi.icon,
      title: gc[gk + "_title"] || t(gi.title),
      quality: gc[gk + "_quality"] || t(gi.quality),
      strengths: gc[gk + "_strengths"] ? lines(gc[gk + "_strengths"]) : gi.strengths.map(function (s) { return t(s); }),
      weaknesses: gc[gk + "_weaknesses"] ? lines(gc[gk + "_weaknesses"]) : gi.weaknesses.map(function (s) { return t(s); }),
    };
  }
%>
<% if (gv) { %>
  <div class="grade-info grade-info-<%= selectedGrade %>">
    <h3 class="grade-info-title"><%= gv.icon %> <%= gv.title %></h3>
    <p class="grade-info-line"><strong><%= t("Quality & appearance:") %></strong>
      <%= gv.quality %></p>
    <% if (gv.strengths.length) { %>
      <p class="grade-info-line"><strong><%= t("Strengths:") %></strong></p>
      <ul class="grade-info-list">
        <% gv.strengths.forEach(function (s) { %><li><%= s %></li><% }) %>
      </ul>
    <% } %>
    <% if (gv.weaknesses.length) { %>
      <p class="grade-info-line"><strong><%= t("Weaknesses:") %></strong></p>
      <ul class="grade-info-list">
        <% gv.weaknesses.forEach(function (s) { %><li><%= s %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<% var newCount = batches.filter(b => b.isNew).length; %>
<% if (newCount) { %>
  <div class="new-cat-banner">
    <span class="ncb-ico">🎉</span>
    <span class="ncb-text"><strong><%= t(newCount === 1 ? "{n} new category" : "{n} new categories", { n: newCount }) %></strong>
      <%= t(newCount === 1 ? "just added — highlighted below with a" : "just added — highlighted at the top with a") %> <span class="ncb-tag">✨ NEW</span> <%= t("tag.") %></span>
  </div>
<% } %>

<% if (!batches.length) { %>
  <p class="muted"><%= selectedGrade ? t("No products for grade {g}.", { g: selectedGrade }) : t("No products.") %></p>
<% } %>
<div class="grid">
  <% batches.forEach(b => { %>
    <div class="card batch <%= b.near_expiry ? 'expiry' : '' %> <%= b.isNew ? 'is-new' : '' %>">
      <% if (b.isNew) { %><span class="new-ribbon">✨ NEW</span><% } %>
      <% var imgs = (b.image_paths && b.image_paths.length) ? b.image_paths : (b.image_path ? [b.image_path] : []); %>
      <div class="batch-img<%= imgs.length ? ' has-img' : '' %>"
        <% if (imgs.length) { %>data-gallery='<%= JSON.stringify(imgs) %>' data-name="<%= b.batch_id %>" role="button" tabindex="0" title="<%= t("Tap to view photos") %>"<% } %>>
        <% if (imgs.length) { %>
          <img src="/uploads/<%= imgs[0] %>" alt="<%= b.batch_id %>">
          <% if (imgs.length > 1) { %><span class="img-count">📷 <%= imgs.length %></span><% } %>
        <% } else { %>
          <span class="batch-img-ph">🟤 <%= t("No image") %></span>
        <% } %>
      </div>
      <div class="batch-head">
        <span class="grade grade-<%= b.grade %>"><%= t("Grade {g}", { g: b.grade }) %></span>
      </div>
      <div class="batch-name-box">
        <p class="batch-name" title="<%= b.batch_id %>"><%= t("Name:") %> <strong><%= b.batch_id %></strong></p>
        <button type="button" class="name-toggle" data-name="<%= b.batch_id %>"><%= t("see more") %></button>
      </div>
      <p class="muted" title="<%= b.warehouse_name %>"><%= t("Warehouse:") %> <%= b.warehouse_name %></p>
      <p class="price"><%= t("{p} Kyats/kg", { p: b.price_per_kg }) %></p>
      <% const r = (typeof ratings !== "undefined") && ratings[b.warehouse_id]; %>
      <% if (r) { %><p class="muted batch-rating">⭐ <%= r.avg %>/5 (<%= t(r.count === 1 ? "{n} review" : "{n} reviews", { n: r.count }) %>)</p>
      <% } else { %><p class="muted batch-rating batch-rating-empty"><%= t("☆ No reviews yet") %></p><% } %>
      <p><%= t("Expire Date:") %> <%= b.expiry_date %></p>
      <p><%= t("Stock:") %> <strong><%= t("{n} kg", { n: b.qty_kg }) %></strong></p>
      <div class="batch-desc">
        <strong><%= t("Ingredients & effectiveness:") %></strong>
        <% if (b.description) { %>
          <span class="desc-text"><%= b.description %></span>
          <button type="button" class="desc-toggle"
                  data-name="<%= b.batch_id %>" data-desc="<%= b.description %>"><%= t("Read more") %></button>
        <% } else { %>
          <span class="desc-text desc-empty"><%= t("No description provided.") %></span>
          <button type="button" class="desc-toggle" aria-hidden="true" tabindex="-1"><%= t("Read more") %></button>
        <% } %>
      </div>

      <div class="batch-action">
      <% if (b.expired) { %>
        <div class="alert err">⛔ <%= t("EXPIRED — cannot order") %></div>
      <% } else { %>
        <% if (b.near_expiry) { %><div class="alert err">⚠ <%= t("Near expiry — order soon") %></div><% } %>
        <% if (b.qty_kg <= 0) { %>
          <div class="alert err"><%= t("Out of stock") %></div>
        <% } else if (user && user.role === "customer") { %>
          <form action="/cart/add" method="post" class="order-form">
            <input type="hidden" name="batch_pk" value="<%= b.id %>">
            <label><%= t("Qty (kg)") %>
              <input type="number" name="qty_kg" min="0.5" step="0.5" max="<%= b.qty_kg %>" required>
            </label>
            <button class="btn" type="submit"><%= t("Add to cart") %></button>
          </form>
        <% } else if (!user) { %>
          <%# Guests browse freely — buying starts at the login page, which sends
              them straight back here afterwards. %>
          <a class="btn" href="/login?next=%2Fbatches&amp;err=<%= encodeURIComponent('Please log in to add items to your cart.') %>"><%= t("🔒 Login to buy") %></a>
        <% } %>
      <% } %>
      </div>
    </div>
  <% }) %>
</div>

<!-- live "your selection" mini-cart (updates as you add/remove, no page jump) -->
<% if (user && user.role === "customer") { %>
<div id="miniCart" class="mini-cart">
  <div class="mini-head">🛒 <%= t("Your selection") %> <span id="miniCount" class="mini-count">0</span></div>
  <div id="miniList" class="mini-list"></div>
  <p id="miniEmpty" class="mini-empty muted"><%= t("No items yet — add products above.") %></p>
  <div class="mini-foot">
    <span><%= t("Subtotal:") %> <strong id="miniSubtotal"><%= t("{n} Kyats", { n: 0 }) %></strong></span>
    <a class="btn sm" href="/cart"><%= t("Go to Cart") %> →</a>
  </div>
</div>
<% } %>

<!-- toast shown after adding to cart (no page jump) -->
<div id="toast" class="toast"></div>

<!-- product photo gallery popup -->
<div id="galleryModal" class="gallery-modal" style="display:none">
  <div class="gallery-box">
    <button type="button" class="gallery-close" id="galleryClose" aria-label="<%= t("Close") %>">✕</button>
    <div class="gallery-title" id="galleryTitle"></div>
    <div class="gallery-main">
      <button type="button" class="gallery-nav prev" id="galleryPrev" aria-label="<%= t("Previous") %>">‹</button>
      <img id="galleryImg" src="" alt="<%= t("product photo") %>">
      <button type="button" class="gallery-nav next" id="galleryNext" aria-label="<%= t("Next") %>">›</button>
    </div>
    <div class="gallery-thumbs" id="galleryThumbs"></div>
  </div>
</div>
<script>
  (function () {
    var L = <%- JSON.stringify({ photos: t("{n} photos") }) %>;
    var modal = document.getElementById("galleryModal");
    if (!modal) return;
    var img = document.getElementById("galleryImg"),
        thumbs = document.getElementById("galleryThumbs"),
        title = document.getElementById("galleryTitle"),
        prev = document.getElementById("galleryPrev"),
        next = document.getElementById("galleryNext");
    var list = [], idx = 0;
    function show(i) {
      idx = (i + list.length) % list.length;
      img.src = "/uploads/" + list[idx];
      Array.prototype.forEach.call(thumbs.children, function (t, k) { t.classList.toggle("active", k === idx); });
    }
    function open(images, name) {
      list = images || []; if (!list.length) return;
      title.textContent = name + (list.length > 1 ? "  ·  " + L.photos.replace("{n}", list.length) : "");
      thumbs.innerHTML = "";
      list.forEach(function (p, k) {
        var t = document.createElement("img");
        t.src = "/uploads/" + p;
        t.addEventListener("click", function () { show(k); });
        thumbs.appendChild(t);
      });
      var multi = list.length > 1;
      thumbs.style.display = multi ? "" : "none";
      prev.style.display = next.style.display = multi ? "" : "none";
      show(0);
      modal.style.display = "flex";
    }
    function close() { modal.style.display = "none"; }
    document.querySelectorAll(".batch-img[data-gallery]").forEach(function (el) {
      function go() { try { open(JSON.parse(el.getAttribute("data-gallery")), el.getAttribute("data-name") || ""); } catch (e) {} }
      el.addEventListener("click", go);
      el.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
    });
    document.getElementById("galleryClose").addEventListener("click", close);
    prev.addEventListener("click", function () { show(idx - 1); });
    next.addEventListener("click", function () { show(idx + 1); });
    modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
    document.addEventListener("keydown", function (e) {
      if (modal.style.display === "none") return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  })();
</script>

<!-- full-description popup (keeps product cards a fixed size) -->
<div id="descModal" class="desc-modal" style="display:none">
  <div class="desc-modal-box">
    <button type="button" class="desc-modal-close" id="descModalClose">✕</button>
    <h3 id="descModalTitle"><%= t("Ingredients & effectiveness") %></h3>
    <p id="descModalBody"></p>
  </div>
</div>

<script>
  // The card shows a fixed 2-line teaser; "Read more" opens the full text in a
  // popup so the product card itself never grows, no matter how long the text is.
  // Runs immediately after a no-reload page swap; waits for load on a first visit.
  (function () {
  var L = <%- JSON.stringify({ ing: t("Ingredients & effectiveness"), productName: t("Product name") }) %>;
  function initDescModal() {
    var modal = document.getElementById("descModal"),
        title = document.getElementById("descModalTitle"),
        body  = document.getElementById("descModalBody");
    document.querySelectorAll(".batch-desc").forEach(function (box) {
      var text = box.querySelector(".desc-text");
      var btn  = box.querySelector(".desc-toggle");
      if (!text || !btn) return;
      // reveal "Read more" only when the teaser is actually cut off
      // (the button always reserves its line via CSS, so all boxes match height)
      if (text.scrollHeight > text.clientHeight + 2) btn.style.visibility = "visible";
      btn.addEventListener("click", function () {
        title.textContent = (btn.dataset.name ? btn.dataset.name + " — " : "") + L.ing;
        body.textContent = btn.dataset.desc || text.textContent;
        modal.style.display = "flex";
      });
    });
    // product name: show "see more" only when the 2-line name is cut off; the
    // popup then shows the full name so the card itself never changes size
    document.querySelectorAll(".batch-name-box").forEach(function (box) {
      var nm  = box.querySelector(".batch-name");
      var btn = box.querySelector(".name-toggle");
      if (!nm || !btn) return;
      if (nm.scrollHeight > nm.clientHeight + 2) btn.style.visibility = "visible";
      btn.addEventListener("click", function () {
        title.textContent = L.productName;
        body.textContent = btn.dataset.name || nm.textContent;
        modal.style.display = "flex";
      });
    });
    function close() { modal.style.display = "none"; }
    document.getElementById("descModalClose").addEventListener("click", close);
    modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
  }
  if (document.readyState === "complete") initDescModal();
  else window.addEventListener("load", initDescModal);
  })();

  // Add/remove WITHOUT leaving the page: keep a live "Your selection" mini-cart,
  // a toast, and the header badge in sync, so customers pick freely then visit the cart.
  (function () {
    var L = <%- JSON.stringify({
      removed: t("Removed"), added: t("Added to cart"),
      loginToContinue: t("Please log in to continue"), couldNotAdd: t("Could not add"),
      kg: t("{n}kg"), kyats: t("{n} Kyats"), remove: t("Remove")
    }) %>;
    var initial = <%- JSON.stringify({ items: cartItems || [], subtotal: cartSubtotal || 0 }) %>;
    var toast = document.getElementById("toast");
    var toastTimer;
    function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]; }); }
    function showToast(msg, isErr) {
      toast.textContent = msg;
      toast.className = "toast show" + (isErr ? " err" : "");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toast.className = "toast"; }, 2200);
    }
    function bumpBadge(count) {
      var link = document.querySelector(".cart-link");
      if (!link) return;
      var badge = link.querySelector(".cart-count");
      if (count > 0) {
        if (!badge) { badge = document.createElement("span"); badge.className = "cart-count"; link.appendChild(badge); }
        badge.textContent = count;
        badge.classList.remove("pop"); void badge.offsetWidth; badge.classList.add("pop");
      } else if (badge) { badge.remove(); }
    }
    function renderMini(items, subtotal) {
      var list = document.getElementById("miniList");
      var empty = document.getElementById("miniEmpty");
      if (!list) return;
      list.innerHTML = "";
      empty.style.display = items.length ? "none" : "block";
      items.forEach(function (it) {
        var row = document.createElement("div"); row.className = "mini-row";
        row.innerHTML = '<span class="mini-name">' + esc(it.name) + '</span>'
          + '<span class="mini-qty">' + L.kg.replace("{n}", it.qty_kg) + '</span>'
          + '<span class="mini-line">' + L.kyats.replace("{n}", it.line_total) + '</span>'
          + '<button class="mini-x" type="button" data-pk="' + it.batch_pk + '" title="' + L.remove + '">✕</button>';
        list.appendChild(row);
      });
      document.getElementById("miniCount").textContent = items.length;
      document.getElementById("miniSubtotal").textContent = L.kyats.replace("{n}", Math.round(subtotal));
      bumpBadge(items.length);
      list.querySelectorAll(".mini-x").forEach(function (b) {
        b.addEventListener("click", function () { removeItem(b.dataset.pk); });
      });
    }
    function removeItem(pk) {
      fetch("/cart/remove", {
        method: "POST",
        headers: { "X-Requested-With": "fetch", "Content-Type": "application/x-www-form-urlencoded" },
        body: "batch_pk=" + encodeURIComponent(pk)
      }).then(function (r) { return r.json(); })
        .then(function (d) { if (d && d.ok) { renderMini(d.items, d.subtotal); showToast(L.removed); } });
    }
    // initial render from the server
    renderMini(initial.items, initial.subtotal);

    document.querySelectorAll(".order-form").forEach(function (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var btn = form.querySelector('button[type="submit"]');
        var body = new URLSearchParams(new FormData(form)).toString();
        btn.disabled = true;
        fetch("/cart/add", {
          method: "POST",
          headers: { "X-Requested-With": "fetch", "Content-Type": "application/x-www-form-urlencoded" },
          body: body
        }).then(function (r) { return r.json(); })
          .then(function (d) {
            btn.disabled = false;
            if (d && d.ok) { renderMini(d.items, d.subtotal); showToast("✓ " + L.added); form.reset(); }
            else if (d && d.login_required) {
              // session expired mid-shop → send them to login, then back here
              showToast(d.error || L.loginToContinue, true);
              setTimeout(function () { window.location.href = d.login_url || "/login"; }, 900);
            }
            else { showToast((d && d.error) || L.couldNotAdd, true); }
          })
          .catch(function () { btn.disabled = false; showToast(L.couldNotAdd, true); });
      });
    });
  })();
</script>
<%- include("../partials/footer") %>
