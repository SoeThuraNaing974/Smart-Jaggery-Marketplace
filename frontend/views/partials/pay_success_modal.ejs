<% if (typeof paid !== "undefined" && paid) { %>
<div class="modal-overlay" id="paySuccessModal">
  <div class="modal-box">
    <div class="pay-check">✓</div>
    <h3 class="modal-title"><%= t("Payment Successful!") %></h3>
    <% if (typeof payAmount !== "undefined" && payAmount) { %>
      <div class="pay-amount"><%= t("{amount} Kyats", { amount: payAmount }) %></div>
    <% } %>
    <p class="modal-text"><%= t((typeof payMsg !== "undefined" && payMsg) ? payMsg : "Your payment has been confirmed. Thank you!") %></p>
    <button class="btn" id="paySuccessClose"><%= t("Done") %></button>
  </div>
</div>
<script>
  (function () {
    var m = document.getElementById("paySuccessModal");
    if (!m) return;
    function close() {
      m.style.display = "none";
      if (history.replaceState) history.replaceState({}, "", location.pathname); // drop ?paid=1 so a refresh won't re-show it
    }
    document.getElementById("paySuccessClose").addEventListener("click", close);
    m.addEventListener("click", function (e) { if (e.target === m) close(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
  })();
</script>
<% } %>
