  </main>
  <script>window.__pageScriptsEnd && window.__pageScriptsEnd();</script>
  <footer class="footer"></footer>

  <%
    // Sticky sign-in bar for visitors: keeps the header uncluttered while leaving
    // signing in one tap away. Hidden on the auth pages themselves (and once the
    // visitor is logged in). `next` brings them back to the page they were on.
    var _guest = !(typeof user !== "undefined" && user);
    var _here = (typeof currentPath !== "undefined" && currentPath) ? currentPath : "/";
    var _onAuthPage = /^\/(login|register)\b/.test(_here);
  %>
  <% if (_guest && !_onAuthPage) { %>
    <div class="guest-bar" role="complementary" aria-label="<%= t('Sign in to order') %>">
      <span class="guest-bar-txt">
        <strong><%= t("Browsing as a guest.") %></strong>
        <span class="guest-bar-hide-sm"><%= t("Sign in to add items to your cart and order.") %></span>
      </span>
      <span class="guest-bar-actions">
        <a class="gbtn ghost" href="/login?next=<%= encodeURIComponent(_here) %>"><%= t("Sign in") %></a>
        <a class="gbtn solid" href="/register?next=<%= encodeURIComponent(_here) %>"><%= t("Join free") %></a>
      </span>
    </div>
  <% } %>

  <!-- global attractive confirm dialog (replaces native confirm) -->
  <div class="modal-overlay confirm-overlay" id="confirmModal" style="display:none">
    <div class="confirm-card">
      <div class="confirm-ring"><span class="confirm-ico" id="confirmIco">🗑️</span></div>
      <h3 class="confirm-title" id="confirmTitle"><%= t("Delete this?") %></h3>
      <p class="confirm-msg" id="confirmMsg"></p>
      <div class="confirm-actions">
        <button type="button" class="confirm-btn cancel" id="confirmCancel">✕ <%= t("Cancel") %></button>
        <button type="button" class="confirm-btn danger" id="confirmOk">🗑️ <%= t("Yes, delete") %></button>
      </div>
    </div>
  </div>
  <script src="/js/nav-progress.js?v=2"></script>
  <script src="/js/responsive-tables.js?v=3"></script>
  <script src="/js/list-scroll.js?v=1"></script>
  <script src="/js/inplace-delete.js?v=2"></script>
  <script src="/js/inplace-image.js?v=3"></script>
  <script src="/js/confirm.js?v=6"></script>
  <script src="/js/upl-menu.js?v=2"></script>
  <script src="/js/bulk-select.js?v=1"></script>
  <script src="/js/ajax-forms.js?v=7"></script>
</body>
</html>
