<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'en' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Smart Jaggery Mart</title>

  <!-- No-reload engine: track page-level listeners/timers so they can be cleanly
       torn down & re-initialised when <main> is swapped in place (see ajax-forms.js). -->
  <script>
    (function () {
      window.__L = { recording: false, listeners: [], timers: [] };
      function wrapAdd(target) {
        var orig = target.addEventListener;
        if (!orig) return;
        target.addEventListener = function (type, fn, opts) {
          if (window.__L.recording) { try { window.__L.listeners.push({ t: this, type: type, fn: fn, opts: opts }); } catch (e) {} }
          return orig.call(this, type, fn, opts);
        };
      }
      wrapAdd(document); wrapAdd(window);
      var si = window.setInterval, st = window.setTimeout;
      window.setInterval = function () { var id = si.apply(window, arguments); if (window.__L.recording) try { window.__L.timers.push(id); } catch (e) {} return id; };
      window.setTimeout = function () { var id = st.apply(window, arguments); if (window.__L.recording) try { window.__L.timers.push(id); } catch (e) {} return id; };
      // markers used by header (just before <main>) and footer (just after </main>)
      window.__pageScriptsBegin = function () { window.__L.recording = true; };
      window.__pageScriptsEnd = function () { window.__L.recording = false; };
    })();
  </script>

  <!-- PWA: installable app on home screen -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#7a4a1e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Smart Jaggery Mart" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        // Auto-update on mobile/PWA: if a service worker already controls this page,
        // a later controllerchange means a NEW version activated — reload once so the
        // phone instantly runs the latest app instead of a stale cached copy.
        var hadController = !!navigator.serviceWorker.controller, reloaded = false;
        if (hadController) {
          navigator.serviceWorker.addEventListener("controllerchange", function () {
            if (reloaded) return; reloaded = true; window.location.reload();
          });
        }
        navigator.serviceWorker.register("/sw.js").then(function (reg) {
          if (reg && reg.update) { try { reg.update(); } catch (e) {} }
        }).catch(function () {});
      });
    }
  </script>

  <script>
    // Shared translated strings for the static JS files (confirm.js dialogs).
    window.__i18n = <%- JSON.stringify({
      delTitle: t("Delete this?"), confirmTitle: t("Please confirm"),
      delMsg: t("This item will be permanently deleted. This can't be undone."),
      confirmMsg: t("Are you sure you want to continue?"),
      delOk: "🗑️ " + t("Yes, delete"), otherOk: "✓ " + t("Yes, continue")
    }) %>;
  </script>
  <link rel="stylesheet" href="/css/style.css?v=192" />
  <%
    // Chart.js is heavy (~200KB). Only load it on the 3 pages that actually draw
    // charts — every other page loads much lighter & faster (especially on mobile).
    var _cur = (typeof currentPath !== "undefined" && currentPath) ? currentPath : "";
    var _needsCharts = ["/dashboard", "/admin", "/warehouse"].indexOf(_cur) !== -1;
  %>
  <% if (_needsCharts) { %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
  <script src="/js/charts.js?v=8" defer></script>
  <% } %>
  <script src="/js/phone.js?v=1" defer></script>
  <script src="/js/scroll-keep.js?v=1"></script>
</head>
<body class="<%= (typeof user !== 'undefined' && user) ? 'role-' + user.role : 'is-guest' %> lang-<%= (typeof lang !== 'undefined' && lang) ? lang : 'en' %>">
  <nav class="nav">
    <a class="brand" href="/"><span class="logo-mark" aria-hidden="true"><span class="lm3"><span class="lm3-orbit"><span class="lm3-arm lm3-arm-1"><i class="lm3-ball lm3-b1"></i></span><span class="lm3-arm lm3-arm-2"><i class="lm3-ball lm3-b2"></i></span></span><span class="lm3-topwrap"><i class="lm3-ball lm3-b3"></i></span></span></span>Smart Jaggery Mart</a>
    <input type="checkbox" id="navToggle" class="nav-toggle" hidden>
    <label for="navToggle" class="nav-burger" aria-label="Toggle menu">&#9776;</label>
    <div class="nav-links">
      <%
        var cur = (typeof currentPath !== "undefined" && currentPath) ? currentPath : "/";
        var navRoots = ["/dashboard", "/admin", "/warehouse", "/"];
        function navCls(href) {
          var active = (navRoots.indexOf(href) !== -1)
            ? cur === href
            : (cur === href || cur.indexOf(href + "/") === 0);
          return active ? "nav-link active" : "nav-link";
        }
      %>
      <% if (user) { %>
        <% if (user.role === "customer") { %>
          <a href="/dashboard" class="<%= navCls('/dashboard') %>"><%= t("Home") %></a>
          <a href="/batches" class="<%= navCls('/batches') %> notif-link"><%= t("Category") %><% if (typeof newCategoryCount !== "undefined" && newCategoryCount > 0) { %><span class="fb-badge" title="<%= t(newCategoryCount === 1 ? '{n} new category added' : '{n} new categories added', { n: newCategoryCount }) %>"><%= newCategoryCount > 9 ? '9+' : newCategoryCount %></span><% } %></a>
          <a href="/cart" class="<%= navCls('/cart') %> cart-link">🛒 <%= t("Cart") %><% if (cartCount) { %><span class="cart-count"><%= cartCount %></span><% } %></a>
          <a href="/orders" class="<%= navCls('/orders') %> notif-link"><%= t("My Order") %><% if (typeof orderUpdateCount !== "undefined" && orderUpdateCount > 0) { %><span class="fb-badge" title="<%= t('{n} order update(s)', { n: orderUpdateCount }) %>"><%= orderUpdateCount > 9 ? '9+' : orderUpdateCount %></span><% } %></a>
        <% } else if (user.role === "warehouse") { %>
          <a href="/warehouse" class="<%= navCls('/warehouse') %> notif-link"><%= t("Home") %><% if (typeof whDeletedCount !== "undefined" && whDeletedCount > 0) { %><span class="fb-badge" title="<%= t(whDeletedCount === 1 ? '{n} of your categories was removed by the admin' : '{n} of your categories were removed by the admin', { n: whDeletedCount }) %>"><%= whDeletedCount > 9 ? '9+' : whDeletedCount %></span><% } %></a>
          <a href="/warehouse/stock-all" class="<%= navCls('/warehouse/stock-all') %> notif-link"><%= t("Category") %><% if (typeof whCategoryCount !== "undefined" && whCategoryCount > 0) { %><span class="fb-badge" title="<%= t(whCategoryCount === 1 ? '{n} new category in your stock' : '{n} new categories in your stock', { n: whCategoryCount }) %>"><%= whCategoryCount > 9 ? '9+' : whCategoryCount %></span><% } %></a>
          <a href="/warehouse/orders-all" class="<%= navCls('/warehouse/orders-all') %> notif-link"><%= t("Orders") %><% if (typeof whOrderCount !== "undefined" && whOrderCount > 0) { %><span class="fb-badge" title="<%= t('{n} new customer order(s)', { n: whOrderCount }) %>"><%= whOrderCount > 9 ? '9+' : whOrderCount %></span><% } %></a>
          <a href="/warehouse/transfers" class="<%= navCls('/warehouse/transfers') %>"><%= t("Request Category") %></a>
          <a href="/warehouse/subscription" class="<%= navCls('/warehouse/subscription') %> notif-link"><%= t("Subscription Plan") %><% if (typeof whPlanCount !== "undefined" && whPlanCount > 0) { %><span class="fb-badge" title="<%= t('{n} new subscription plan(s)', { n: whPlanCount }) %>"><%= whPlanCount > 9 ? '9+' : whPlanCount %></span><% } %></a>
        <% } else if (user.role === "admin") { %>
          <a href="/admin" class="<%= navCls('/admin') %>"><%= t("Home") %></a>
          <% var catAttn = (typeof pendingRequestCount !== "undefined" ? pendingRequestCount : 0) + (typeof deletedStockCount !== "undefined" ? deletedStockCount : 0); %>
          <a href="/admin/batches" class="<%= navCls('/admin/batches') %> notif-link"><%= t("Category") %><% if (catAttn > 0) { %><span class="fb-badge" title="<%= t('{n} item(s) need attention', { n: catAttn }) %>"><%= catAttn > 9 ? '9+' : catAttn %></span><% } %></a>
          <a href="/admin/subscriptions" class="<%= navCls('/admin/subscriptions') %> notif-link"><%= t("Subscription Plan") %><% if (typeof newPaymentCount !== "undefined" && newPaymentCount > 0) { %><span class="fb-badge" title="<%= t('{n} new subscription payment(s)', { n: newPaymentCount }) %>"><%= newPaymentCount > 9 ? '9+' : newPaymentCount %></span><% } %></a>
          <a href="/admin/promotions" class="<%= navCls('/admin/promotions') %>"><%= t("Promotion") %></a>
          <a href="/admin/advertisements" class="<%= navCls('/admin/advertisements') %>"><%= t("Advertisement") %></a>
          <a href="/admin/delivery-charges" class="<%= navCls('/admin/delivery-charges') %>"><%= t("Delivery Charges") %></a>
          <a href="/admin/announcements" class="<%= navCls('/admin/announcements') %>"><%= t("Announcement") %></a>
          <% var accAttn = (typeof newWarehouseCount !== "undefined" ? newWarehouseCount : 0) + (typeof newUserCount !== "undefined" ? newUserCount : 0); %>
          <a href="/admin/directory" class="<%= navCls('/admin/directory') %> notif-link"><%= t("Accounts") %><% if (accAttn > 0) { %><span class="fb-badge" title="<%= t('{n} new registration(s)', { n: accAttn }) %>"><%= accAttn > 9 ? '9+' : accAttn %></span><% } %></a>
        <% } %>
        <a href="/profile" class="<%= navCls('/profile') %>"><%= t("Profile") %></a>
        <span class="user-pill">
          <span class="user-ava" title="<%= user.name || user.role %>">
            <% if (user.avatar_path) { %>
              <img class="user-ava-img" src="/uploads/<%= user.avatar_path %>" alt="<%= user.name || user.role %>">
            <% } else { %>
              <span class="user-ava-img user-ava-initial"><%= (user.name || user.role || '?').trim().charAt(0).toUpperCase() %></span>
            <% } %>
            <span class="user-ava-dot" aria-hidden="true"></span>
          </span>
          <%= user.name || user.role %>
        </span>
        <form action="/logout" method="post" style="display:inline">
          <button class="logout-btn" type="submit"><svg class="logout-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.75v8.5"/><path d="M7.05 6.4a7.5 7.5 0 1 0 9.9 0"/></svg> <%= t("Logout") %></button>
        </form>
      <% } else { %>
        <%# Guest: a clean browse-only bar. Signing in is offered by the landing
            hero, the category-page notice and the sticky bar (see footer) —
            not as plain links crowding the header. %>
        <a href="/" class="<%= navCls('/') %>"><%= t("Home") %></a>
        <a href="/batches" class="<%= navCls('/batches') %>"><%= t("Category") %></a>
        <a href="/about" class="<%= navCls('/about') %>"><%= t("About Us") %></a>
      <% } %>
      <%# Language switcher (all roles + guests). data-no-ajax forces a full page
          load so the header nav itself re-renders in the chosen language. %>
      <a href="/lang/<%= lang === 'my' ? 'en' : 'my' %>" class="nav-link lang-switch" data-no-ajax
         title="<%= lang === 'my' ? 'Switch to English' : 'မြန်မာဘာသာသို့ ပြောင်းရန်' %>">🌐 <%= lang === 'my' ? 'English' : 'မြန်မာ' %></a>
    </div>
    <!-- dimmed backdrop behind the open mobile menu; tapping it closes the menu -->
    <label for="navToggle" class="nav-backdrop" aria-hidden="true"></label>
  </nav>

  <% if (user && user.role === "customer") { %>
  <script>
    // Live header notifications (Facebook-style badge + slide-in pop-up):
    //   • Category — a newly published jaggery category
    //   • My Order — when a warehouse ships / delivers the customer's order
    (function () {
      // server-translated strings ({n} is filled in client-side by fmt)
      var L = <%- JSON.stringify({
        view: t("View"), dismiss: t("Dismiss"),
        catSub: t("A new jaggery category is available."),
        catOne: t("🎉 {n} new category added!"), catMany: t("🎉 {n} new categories added!"),
        ordSub: t("Tap View to track your order."),
        ordDelivered: t("📦 Your order (No-{n}) has been delivered!"),
        ordShipped: t("🚚 Your order (No-{n}) has been shipped!"),
        ordOne: t("🚚 {n} order update!"), ordMany: t("🚚 {n} order updates!")
      }) %>;
      function fmt(s, n) { return String(s).replace("{n}", n); }
      var stack;
      function ensureStack() {
        if (!stack) { stack = document.createElement("div"); stack.className = "cat-popup-stack"; document.body.appendChild(stack); }
        return stack;
      }
      // one independent notification "channel" per nav link
      function makeChannel(opts) {
        var link = opts.link;
        if (!link) return { update: function () {} };
        var popupEl = null;
        function badgeCount() { var b = link.querySelector(".fb-badge"); if (!b) return 0; var t = (b.textContent || "").trim(); return t === "9+" ? 10 : (parseInt(t, 10) || 0); }
        var prev = badgeCount(); // server-rendered starting point — no pop-up on first load
        function setBadge(count) {
          var b = link.querySelector(".fb-badge");
          if (count > 0) {
            var txt = count > 9 ? "9+" : String(count);
            if (!b) { b = document.createElement("span"); b.className = "fb-badge"; link.appendChild(b); }
            if (b.textContent !== txt) { b.textContent = txt; b.style.animation = "none"; void b.offsetWidth; b.style.animation = ""; }
          } else if (b) { b.remove(); }
        }
        function showPopup(title) {
          if (!popupEl) {
            popupEl = document.createElement("div");
            popupEl.className = "cat-popup";
            popupEl.innerHTML =
              '<span class="cp-ico">' + (opts.icon || "🔔") + '</span>' +
              '<div class="cp-body"><div class="cp-title"></div><div class="cp-sub">' + opts.subText + '</div></div>' +
              '<button type="button" class="cp-view">' + L.view + '</button>' +
              '<button type="button" class="cp-close" aria-label="' + L.dismiss + '">✕</button>';
            ensureStack().appendChild(popupEl);
            popupEl.querySelector(".cp-view").addEventListener("click", function () {
              if (location.pathname === opts.viewUrl) location.reload(); else location.href = opts.viewUrl;
            });
            popupEl.querySelector(".cp-close").addEventListener("click", hidePopup);
          }
          popupEl.querySelector(".cp-title").textContent = title;
          popupEl.classList.remove("show"); void popupEl.offsetWidth; popupEl.classList.add("show");
          // no auto-hide — stays until checked (View / ✕) or the page is refreshed/left
        }
        function hidePopup() {
          // fade out + collapse the slot so the pop-ups below slide up, then drop the node
          var el = popupEl;
          if (!el) return;
          popupEl = null; // a later notification builds a fresh pop-up
          el.style.height = el.offsetHeight + "px"; // freeze auto height so it can animate to 0
          void el.offsetWidth;
          el.classList.remove("show"); el.classList.add("hide");
          setTimeout(function () { el.remove(); }, 480);
        }
        var firstRun = true;
        return { update: function (count, data) {
          setBadge(count);
          // categories: pop only when the count rises. orders (showOnLoad): pop on EVERY page
          // while there's an unchecked update, so it follows the customer until they open My Order.
          if ((count > prev) || (opts.showOnLoad && firstRun && count > 0)) showPopup(opts.buildTitle(count, data));
          else if (count === 0) hidePopup(); // checked elsewhere — clear the stale pop-up so the stack closes up
          prev = count; firstRun = false;
        } };
      }

      var catCh = makeChannel({
        link: document.querySelector('.nav-links a[href="/batches"]'),
        viewUrl: "/batches", icon: "🎉", subText: L.catSub,
        showOnLoad: true, // keep showing on every page until checked on the Category page
        buildTitle: function (c) { return fmt(c === 1 ? L.catOne : L.catMany, c); }
      });
      var ordCh = makeChannel({
        link: document.querySelector('.nav-links a[href="/orders"]'),
        viewUrl: "/orders", icon: "🚚", subText: L.ordSub,
        showOnLoad: true, // keep showing on every page until checked on My Order
        buildTitle: function (c, data) {
          if (data && data.items && data.items.length === 1) {
            var it = data.items[0];
            return fmt(it.status === "delivered" ? L.ordDelivered : L.ordShipped, it.seq);
          }
          return fmt(c === 1 ? L.ordOne : L.ordMany, c);
        }
      });

      var polling = false;
      function poll() {
        if (polling) return;
        polling = true;
        Promise.all([
          fetch("/notifications/categories", { headers: { "X-Requested-With": "fetch" } }).then(function (r) { return r.ok ? r.json() : { count: 0 }; }).catch(function () { return { count: 0 }; }),
          fetch("/orders/notifications", { headers: { "X-Requested-With": "fetch" } }).then(function (r) { return r.ok ? r.json() : { count: 0 }; }).catch(function () { return { count: 0 }; })
        ]).then(function (res) {
          catCh.update(Number(res[0].count) || 0, res[0]);
          ordCh.update(Number(res[1].count) || 0, res[1]);
        }).then(function () { polling = false; }, function () { polling = false; });
      }
      setTimeout(poll, 800);   // show quickly on every page load
      setInterval(poll, 15000);
      window.addEventListener("focus", poll);
      document.addEventListener("visibilitychange", function () { if (document.visibilityState === "visible") poll(); });
    })();
  </script>
  <% } %>

  <% if (user && user.role === "warehouse") { %>
  <script>
    // Warehouse header notifications: same badge + slide-in pop-up as the customer side,
    // for (1) new product categories in this warehouse's stock and (2) new subscription plans.
    (function () {
      var L = <%- JSON.stringify({ view: t("View"), dismiss: t("Dismiss") }) %>;
      function fmt(s, n) { return String(s).replace("{n}", n); }
      var stack;
      function ensureStack() {
        if (!stack) { stack = document.createElement("div"); stack.className = "cat-popup-stack"; document.body.appendChild(stack); }
        return stack;
      }
      // one independent notification "channel" per nav link
      // tplOne / tplMany: full pre-translated pop-up titles with a {n} placeholder
      function makeChannel(link, viewUrl, tplOne, tplMany, subText, showOnLoad, icon) {
        if (!link) return { update: function () {} };
        var popupEl = null;
        function badgeCount() {
          var b = link.querySelector(".fb-badge");
          if (!b) return 0;
          var t = (b.textContent || "").trim();
          return t === "9+" ? 10 : (parseInt(t, 10) || 0);
        }
        var prev = badgeCount();
        function setBadge(count) {
          var b = link.querySelector(".fb-badge");
          if (count > 0) {
            var txt = count > 9 ? "9+" : String(count);
            if (!b) { b = document.createElement("span"); b.className = "fb-badge"; link.appendChild(b); }
            if (b.textContent !== txt) { b.textContent = txt; b.style.animation = "none"; void b.offsetWidth; b.style.animation = ""; }
          } else if (b) { b.remove(); }
        }
        function showPopup(count) {
          if (!popupEl) {
            popupEl = document.createElement("div");
            popupEl.className = "cat-popup";
            popupEl.innerHTML =
              '<span class="cp-ico">🔔</span>' +
              '<div class="cp-body"><div class="cp-title"></div><div class="cp-sub">' + subText + '</div></div>' +
              '<button type="button" class="cp-view">' + L.view + '</button>' +
              '<button type="button" class="cp-close" aria-label="' + L.dismiss + '">✕</button>';
            ensureStack().appendChild(popupEl);
            popupEl.querySelector(".cp-view").addEventListener("click", function () {
              if (location.pathname === viewUrl) location.reload(); else location.href = viewUrl;
            });
            popupEl.querySelector(".cp-close").addEventListener("click", hidePopup);
          }
          popupEl.querySelector(".cp-title").textContent = fmt(count === 1 ? tplOne : tplMany, count);
          popupEl.classList.remove("show"); void popupEl.offsetWidth; popupEl.classList.add("show");
          // no auto-hide — stays until checked (View / ✕) or the page is refreshed/left
        }
        function hidePopup() {
          // fade out + collapse the slot so the pop-ups below slide up, then drop the node
          var el = popupEl;
          if (!el) return;
          popupEl = null; // a later notification builds a fresh pop-up
          el.style.height = el.offsetHeight + "px"; // freeze auto height so it can animate to 0
          void el.offsetWidth;
          el.classList.remove("show"); el.classList.add("hide");
          setTimeout(function () { el.remove(); }, 480);
        }
        var firstRun = true;
        return { update: function (count) {
          setBadge(count);
          if ((count > prev) || (showOnLoad && firstRun && count > 0)) showPopup(count);
          else if (count === 0) hidePopup(); // checked elsewhere — clear the stale pop-up so the stack closes up
          prev = count; firstRun = false;
        } };
      }
      var catCh = makeChannel(document.querySelector('.nav-links a[href="/warehouse/stock-all"]'),
        "/warehouse/stock-all", <%- JSON.stringify(t("🎉 {n} new category!")) %>, <%- JSON.stringify(t("🎉 {n} new categories!")) %>,
        <%- JSON.stringify(t("New product categories are in your stock.")) %>, true, "🎉");
      var subCh = makeChannel(document.querySelector('.nav-links a[href="/warehouse/subscription"]'),
        "/warehouse/subscription", <%- JSON.stringify(t("💳 {n} new subscription plan!")) %>, <%- JSON.stringify(t("💳 {n} new subscription plans!")) %>,
        <%- JSON.stringify(t("A new subscription plan is available.")) %>, false, "💳");
      var ordCh = makeChannel(document.querySelector('.nav-links a[href="/warehouse/orders-all"]'),
        "/warehouse/orders-all", <%- JSON.stringify(t("🛒 {n} new customer order!")) %>, <%- JSON.stringify(t("🛒 {n} new customer orders!")) %>,
        <%- JSON.stringify(t("A customer just placed an order — open Orders to handle it.")) %>, true, "🛒");

      var polling = false;
      function poll() {
        if (polling) return;
        polling = true;
        fetch("/warehouse/notifications", { headers: { "X-Requested-With": "fetch" } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { if (!d) return; catCh.update(Number(d.categories) || 0); subCh.update(Number(d.plans) || 0); ordCh.update(Number(d.orders) || 0); })
          .catch(function () { /* offline / transient — keep current badges */ })
          .then(function () { polling = false; });
      }
      setTimeout(poll, 800);   // show quickly on every page load
      setInterval(poll, 15000);
      window.addEventListener("focus", poll);
      document.addEventListener("visibilitychange", function () { if (document.visibilityState === "visible") poll(); });
    })();
  </script>
  <% } %>

  <% if (user && user.role === "admin") { %>
  <script>
    // Admin header notifications: badge + slide-in pop-up for (1) new product requests,
    // (2) stocks DELETED by a warehouse (alarm — stays until acknowledged), and
    // (3) new subscription payments. Requests + deleted stock share the Category badge.
    (function () {
      var L = <%- JSON.stringify({ view: t("View"), dismiss: t("Dismiss") }) %>;
      function fmt(s, n) { return String(s).replace("{n}", n); }
      var stack;
      function ensureStack() {
        if (!stack) { stack = document.createElement("div"); stack.className = "cat-popup-stack"; document.body.appendChild(stack); }
        return stack;
      }
      var catLink = document.querySelector('.nav-links a[href="/admin/batches"]');
      var subLink = document.querySelector('.nav-links a[href="/admin/subscriptions"]');
      var dirLink = document.querySelector('.nav-links a[href="/admin/directory"]');
      function setBadge(link, count) {
        if (!link) return;
        var b = link.querySelector(".fb-badge");
        if (count > 0) {
          var txt = count > 9 ? "9+" : String(count);
          if (!b) { b = document.createElement("span"); b.className = "fb-badge"; link.appendChild(b); }
          if (b.textContent !== txt) { b.textContent = txt; b.style.animation = "none"; void b.offsetWidth; b.style.animation = ""; }
        } else if (b) { b.remove(); }
      }
      // popup-only channel (badges are managed separately so two channels can share one link)
      function popupChannel(opts) {
        var popupEl = null, prev = opts.baseline || 0, firstRun = true;
        function showPopup(count) {
          if (!popupEl) {
            popupEl = document.createElement("div");
            popupEl.className = "cat-popup" + (opts.alarm ? " alarm" : "");
            popupEl.innerHTML =
              '<span class="cp-ico">' + opts.icon + '</span>' +
              '<div class="cp-body"><div class="cp-title"></div><div class="cp-sub">' + opts.subText + '</div></div>' +
              '<button type="button" class="cp-view">' + L.view + '</button>' +
              '<button type="button" class="cp-close" aria-label="' + L.dismiss + '">✕</button>';
            ensureStack().appendChild(popupEl);
            popupEl.querySelector(".cp-view").addEventListener("click", function () {
              if (location.pathname === opts.viewUrl) location.reload(); else location.href = opts.viewUrl;
            });
            popupEl.querySelector(".cp-close").addEventListener("click", hidePopup);
          }
          popupEl.querySelector(".cp-title").textContent = fmt(count === 1 ? opts.one : opts.many, count);
          popupEl.classList.remove("show"); void popupEl.offsetWidth; popupEl.classList.add("show");
        }
        function hidePopup() {
          // fade out + collapse the slot so the pop-ups below slide up, then drop the node
          var el = popupEl;
          if (!el) return;
          popupEl = null; // a later notification builds a fresh pop-up
          el.style.height = el.offsetHeight + "px"; // freeze auto height so it can animate to 0
          void el.offsetWidth;
          el.classList.remove("show"); el.classList.add("hide");
          setTimeout(function () { el.remove(); }, 480);
        }
        return { update: function (count) {
          if ((count > prev) || (opts.showOnLoad && firstRun && count > 0)) showPopup(count);
          else if (count === 0) hidePopup(); // checked elsewhere — clear the stale pop-up so the stack closes up
          prev = count; firstRun = false;
        } };
      }
      <%# one/many are full pre-translated titles with {n}; icon is baked into them %>
      var reqCh = popupChannel({ icon: "🆕", viewUrl: "/admin/batches", showOnLoad: true,
        baseline: <%= (typeof pendingRequestCount !== "undefined" ? pendingRequestCount : 0) %>,
        one: <%- JSON.stringify(t("🆕 {n} new product request!")) %>, many: <%- JSON.stringify(t("🆕 {n} new product requests!")) %>,
        subText: <%- JSON.stringify(t("A warehouse is requesting a new product.")) %> });
      var delCh = popupChannel({ icon: "🗑️", viewUrl: "/admin/batches", showOnLoad: true, alarm: true,
        baseline: <%= (typeof deletedStockCount !== "undefined" ? deletedStockCount : 0) %>,
        one: <%- JSON.stringify(t("🗑️ {n} stock deleted by a warehouse!")) %>, many: <%- JSON.stringify(t("🗑️ {n} stocks deleted by warehouses!")) %>,
        subText: <%- JSON.stringify(t("Review the deleted stock on the Category page.")) %> });
      var payCh = popupChannel({ icon: "💳", viewUrl: "/admin/subscriptions", showOnLoad: true,
        baseline: <%= (typeof newPaymentCount !== "undefined" ? newPaymentCount : 0) %>,
        one: <%- JSON.stringify(t("💳 {n} new subscription payment!")) %>, many: <%- JSON.stringify(t("💳 {n} new subscription payments!")) %>,
        subText: <%- JSON.stringify(t("A warehouse bought / extended a subscription.")) %> });
      var whAccCh = popupChannel({ icon: "🏬", viewUrl: "/admin/directory", showOnLoad: true,
        baseline: <%= (typeof newWarehouseCount !== "undefined" ? newWarehouseCount : 0) %>,
        one: <%- JSON.stringify(t("🏬 {n} new warehouse registered!")) %>, many: <%- JSON.stringify(t("🏬 {n} new warehouses registered!")) %>,
        subText: <%- JSON.stringify(t("A new warehouse just registered — review it on the Accounts page.")) %> });
      var userAccCh = popupChannel({ icon: "🧑", viewUrl: "/admin/directory", showOnLoad: true,
        baseline: <%= (typeof newUserCount !== "undefined" ? newUserCount : 0) %>,
        one: <%- JSON.stringify(t("🧑 {n} new user registered!")) %>, many: <%- JSON.stringify(t("🧑 {n} new users registered!")) %>,
        subText: <%- JSON.stringify(t("A new user just registered — review it on the Accounts page.")) %> });

      var polling = false;
      function poll() {
        if (polling) return;
        polling = true;
        fetch("/admin/notifications", { headers: { "X-Requested-With": "fetch" } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d) return;
            var req = Number(d.requests) || 0, del = Number(d.deletedStocks) || 0, pay = Number(d.payments) || 0;
            var newWh = Number(d.newWarehouses) || 0, newU = Number(d.newUsers) || 0;
            setBadge(catLink, req + del);   // Category badge = requests + deleted stock
            setBadge(subLink, pay);
            setBadge(dirLink, newWh + newU);   // Accounts badge = new warehouses + new users
            reqCh.update(req); delCh.update(del); payCh.update(pay);
            whAccCh.update(newWh); userAccCh.update(newU);
          })
          .catch(function () { /* offline / transient — keep current badges */ })
          .then(function () { polling = false; });
      }
      setTimeout(poll, 800);
      setInterval(poll, 15000);
      window.addEventListener("focus", poll);
      document.addEventListener("visibilitychange", function () { if (document.visibilityState === "visible") poll(); });
    })();
  </script>
  <% } %>

  <script>window.__pageScriptsBegin && window.__pageScriptsBegin();</script>
  <main class="container">
    <% if (typeof flash !== "undefined" && flash) { %><div class="alert ok"><%= t(flash) %></div><% } %>
    <% if (typeof error !== "undefined" && error) { %><div class="alert err"><%= t(error) %></div><% } %>
