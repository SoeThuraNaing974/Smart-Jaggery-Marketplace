<%- include("partials/header") %>

<%# Public "About us" page. The facts describe how the platform works — replace
    the contact details below with your real ones (marked TODO). %>
<div class="a3d-stage">

  <section class="a3d-hero" id="a3dHero">
    <div class="a3d-hero-inner">
      <div class="a3d-copy">
        <span class="a3d-eyebrow">🍯 <%= t("About us") %></span>
        <h1 class="a3d-headline"><%= t("Local jaggery,") %> <span><%= t("one honest marketplace.") %></span></h1>
        <p class="a3d-sub"><%= t("Growers, warehouses and buyers in one place — with one basket, one payment and one delivery, however many warehouses you buy from.") %></p>
        <div class="a3d-hero-actions">
          <a class="gbtn solid" href="/batches">🛍️ <%= t("Browse categories") %></a>
          <a class="gbtn ghost" href="/register?next=%2Fbatches"><%= t("Create an account") %></a>
        </div>
      </div>
      <%# a real 3D cube: six faces rotated in space, slowly spinning %>
      <div class="a3d-cube-wrap" aria-hidden="true">
        <div class="a3d-cube" id="a3dCube">
          <i>🍯</i><i>🌾</i><i>🧊</i><i>🚚</i><i>⭐</i><i>🛍️</i>
        </div>
        <div class="a3d-cube-shadow"></div>
      </div>
    </div>
  </section>

  <div class="a3d-panel a3d-reveal">
    <h3><%= t("Who we are") %></h3>
    <p><%= t("Smart Jaggery Mart brings Myanmar's jaggery makers and buyers together in one place. Producers store their harvest in their own warehouses and list it here; you see the same grade, price and stock they do — no middleman marking things up along the way.") %></p>
    <p class="muted"><%= t("Every product carries the warehouse that made it, its grade, its harvest and expiry dates, and the star rating other buyers gave it.") %></p>
  </div>

  <div class="a3d-panel a3d-reveal">
    <h3><%= t("How ordering works") %></h3>
    <ol class="a3d-steps">
      <li class="a3d-step a3d-reveal">
        <span class="a3d-step-no">1</span>
        <h4><%= t("Browse freely") %></h4>
        <p><%= t("The whole catalogue is open — no account needed to see products, prices or promotions.") %></p>
      </li>
      <li class="a3d-step a3d-reveal">
        <span class="a3d-step-no">2</span>
        <h4><%= t("Fill one basket") %></h4>
        <p><%= t("Mix items from as many warehouses as you like; they all go into a single order.") %></p>
      </li>
      <li class="a3d-step a3d-reveal">
        <span class="a3d-step-no">3</span>
        <h4><%= t("Pay once") %></h4>
        <p><%= t("One payment covers the lot and is held safely by the platform until your order is on its way.") %></p>
      </li>
      <li class="a3d-step a3d-reveal">
        <span class="a3d-step-no">4</span>
        <h4><%= t("One rider, one delivery") %></h4>
        <p><%= t("Rather than a courier per warehouse, a single rider collects from each in turn and delivers everything together — one trip, one delivery fee.") %></p>
      </li>
      <li class="a3d-step a3d-reveal">
        <span class="a3d-step-no">5</span>
        <h4><%= t("Paid on delivery") %></h4>
        <p><%= t("Once your jaggery arrives, each warehouse is paid its share automatically.") %></p>
      </li>
    </ol>
  </div>

  <div class="a3d-grid">
    <div class="a3d-tile a3d-reveal" data-tilt>
      <span class="a3d-tile-ico">🌾</span>
      <h4><%= t("Graded, never guessed") %></h4>
      <p><%= t("Grade A, B or C is recorded per batch, with the harvest date in the open.") %></p>
    </div>
    <div class="a3d-tile a3d-reveal" data-tilt>
      <span class="a3d-tile-ico">📅</span>
      <h4><%= t("Freshness enforced") %></h4>
      <p><%= t("Jaggery near its expiry is flagged, and expired stock cannot be ordered at all.") %></p>
    </div>
    <div class="a3d-tile a3d-reveal" data-tilt>
      <span class="a3d-tile-ico">🚚</span>
      <h4><%= t("Delivery you can price") %></h4>
      <p><%= t("The charge for your city is shown before you order — no surprises at checkout.") %></p>
    </div>
    <div class="a3d-tile a3d-reveal" data-tilt>
      <span class="a3d-tile-ico">⭐</span>
      <h4><%= t("Reviews that count") %></h4>
      <p><%= t("Only buyers whose order was delivered can rate a warehouse.") %></p>
    </div>
  </div>

  <div class="a3d-panel a3d-panel-cta a3d-reveal">
    <h3><%= t("Selling with us") %></h3>
    <p><%= t("Run a jaggery warehouse? Register as a warehouse to list your stock, manage your own orders, and get paid into your wallet as each delivery completes.") %></p>
    <div class="acc-actions">
      <a class="btn" href="/register"><%= t("Register your warehouse") %></a>
      <a class="btn sm gray" href="/batches"><%= t("See what's on the shop") %></a>
    </div>
  </div>

  <div class="a3d-panel a3d-reveal">
    <h3><%= t("Get in touch") %></h3>
    <p class="muted"><%= t("Questions about an order, a product, or selling with us — reach the team and we'll come back to you.") %></p>
    <%# TODO: replace with your real contact details. %>
    <p><strong><%= t("Email:") %></strong> <a href="mailto:hello@smartjaggerymart.local">hello@smartjaggerymart.local</a></p>
  </div>
</div>

<script>
  /* 3D motion for the About page.
     Everything here is an ENHANCEMENT layered on top of a page that already reads
     correctly: the reveal start-state lives behind html.a3d-ready, which is only
     added when we know we can finish the job. If the observer never fires (hidden
     tab, throttled rendering), the safety timer reveals everything anyway. */
  (function () {
    var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var items = [].slice.call(document.querySelectorAll(".a3d-reveal"));

    // ---- depth scroll-reveal ----
    if (items.length && !reduced && "IntersectionObserver" in window) {
      document.documentElement.classList.add("a3d-ready");
      var revealAll = function () { items.forEach(function (el) { el.classList.add("in"); }); };
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var el = e.target;
          // stagger siblings so a row of tiles cascades instead of popping at once
          var peers = [].slice.call((el.parentNode || document).children).filter(function (c) {
            return c.classList && c.classList.contains("a3d-reveal");
          });
          var i = Math.max(0, peers.indexOf(el));
          setTimeout(function () { el.classList.add("in"); }, Math.min(i * 90, 450));
          io.unobserve(el);
        });
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
      items.forEach(function (el) { io.observe(el); });
      // belt and braces: never leave content hidden, whatever the browser does
      setTimeout(revealAll, 2500);
      window.addEventListener("beforeprint", revealAll);
    }

    // ---- pointer-tracked tilt + specular sheen on the feature tiles ----
    if (!reduced && window.matchMedia("(hover: hover)").matches) {
      document.querySelectorAll("[data-tilt]").forEach(function (card) {
        var frame = null;
        card.addEventListener("pointermove", function (ev) {
          if (frame) return;                       // one update per animation frame
          frame = requestAnimationFrame(function () {
            frame = null;
            var r = card.getBoundingClientRect();
            var px = (ev.clientX - r.left) / r.width;      // 0..1
            var py = (ev.clientY - r.top) / r.height;
            card.style.setProperty("--ry", ((px - 0.5) * 13).toFixed(2) + "deg");
            card.style.setProperty("--rx", ((0.5 - py) * 11).toFixed(2) + "deg");
            card.style.setProperty("--mx", (px * 100).toFixed(1) + "%");
            card.style.setProperty("--my", (py * 100).toFixed(1) + "%");
          });
        });
        card.addEventListener("pointerleave", function () {
          card.style.setProperty("--rx", "0deg");
          card.style.setProperty("--ry", "0deg");
        });
      });

      // ---- gentle parallax: the hero leans towards the cursor ----
      var hero = document.getElementById("a3dHero");
      if (hero) {
        var hFrame = null;
        hero.addEventListener("pointermove", function (ev) {
          if (hFrame) return;
          hFrame = requestAnimationFrame(function () {
            hFrame = null;
            var r = hero.getBoundingClientRect();
            var px = (ev.clientX - r.left) / r.width, py = (ev.clientY - r.top) / r.height;
            hero.style.transform = "perspective(1100px) rotateY(" + ((px - 0.5) * 5).toFixed(2)
              + "deg) rotateX(" + ((0.5 - py) * 4).toFixed(2) + "deg)";
          });
        });
        hero.addEventListener("pointerleave", function () { hero.style.transform = ""; });
      }
    }
  })();
</script>

<%- include("partials/footer") %>
