<%- include("partials/header") %>
<% var nextUrl = (typeof next !== "undefined" && next) ? next : ""; %>
<div class="card narrow">
  <h2><%= t("Login") %></h2>
  <%# the error banner is rendered once by partials/header (it reads the same local) %>
  <form action="/login" method="post">
    <% if (nextUrl) { %><input type="hidden" name="next" value="<%= nextUrl %>"><% } %>
    <label><%= t("Email") %> <input type="email" name="email" required></label>
    <label><%= t("Password") %> <input type="password" name="password" required></label>
    <button class="btn" type="submit"><%= t("Login") %></button>
  </form>
  <p class="muted"><%= t("No account?") %>
    <a href="/register<%= nextUrl ? '?next=' + encodeURIComponent(nextUrl) : '' %>"><%= t("Register as customer / warehouse") %></a>
  </p>
</div>
<%- include("partials/footer") %>
